rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ─────────────────────────────────────
    function estaLogado() {
      return request.auth != null;
    }

    // E-mail confirmado pelo link do Firebase Auth. A pessoa convidada cria a
    // própria conta de login (o cadastro fica aberto), então o e-mail do token
    // só prova quem ela é depois de confirmado: sem isso, alguém criaria a
    // conta com o e-mail de outra pessoa e usaria o convite dela
    function emailConfirmado() {
      return estaLogado() && request.auth.token.get('email_verified', false) == true;
    }

    // Conta da demonstração pública. A senha dela vai no js/config.js do
    // site, então qualquer pessoa pode usá-la fora da interface. Por isso ela
    // tem um perfil próprio, 'demo', que não vale como nenhum outro: só lê e
    // grava o que é da demonstração (documentos com isDemo == true, pedidos
    // com ID "demo-…" e os avisos das pessoas da demo). Os IDs automáticos do
    // Firestore não têm hífen, então nenhum pedido real cai nessa área.
    // As permissões gravadas no token (custom claims) não valem para ela.
    function eDemo() {
      return estaLogado() && request.auth.token.get('email', '') == 'demo@praxis.app';
    }

    // Perfil e empresas de quem está logado. Com a Cloud Function setUserClaims
    // (plano Blaze), vêm do token (custom claims). Sem ela, no plano gratuito,
    // vêm do documento da própria pessoa em /usuarios, que só um gestor ou o
    // supremo altera (regras de /usuarios abaixo). Usuário inativo fica sem perfil.
    function temClaims() {
      return request.auth.token.get('perfil', null) != null;
    }
    function caminhoMeuUsuario() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function meuDocumento() {
      return exists(caminhoMeuUsuario()) ? get(caminhoMeuUsuario()).data : {};
    }
    function perfilDoDocumento() {
      return meuDocumento().get('ativo', true) == false ? null : meuDocumento().get('perfil', null);
    }
    function perfil() {
      return eDemo() ? 'demo' : (temClaims() ? request.auth.token.perfil : perfilDoDocumento());
    }

    function idDemo(id) { return id.matches('demo-.*'); }
    function marcadoDemo(dados) { return dados.get('isDemo', false) == true; }

    // A conta demo lê só o que está marcado como demo (a consulta precisa
    // filtrar por isDemo == true) e grava só documentos que continuam
    // marcados. Um documento que já existe só é regravado se já era da demo.
    function leDemo() { return eDemo() && marcadoDemo(resource.data); }
    function gravaDemo(id) {
      return eDemo() && marcadoDemo(request.resource.data) &&
        (resource == null || marcadoDemo(resource.data) || idDemo(id));
    }

    // Conta sem perfil (criada fora do app) não lê nem grava nada
    function temPerfil() {
      return estaLogado() &&
        perfil() in ['supremo', 'gestor', 'aprovador', 'comprador', 'financeiro', 'solicitante'];
    }

    // ── Acesso por módulo (27/11/2026) ─────────────────────────
    // `perfil` é o papel em Compras (temPerfil acima). Serviços e Equipamentos
    // têm papel próprio no usuário (`servicos`, `equipamentos`). Duas contas
    // não têm Compras: 'nenhum' (pessoa da empresa só com os outros módulos)
    // e 'prestador' (técnico ou conta de uma prestadora, de fora: só os
    // chamados da prestadora dele, em `fornecedorId`). O supremo tem todos os
    // módulos no papel mais alto. Espelho do app em js/modulos.js.
    // Tudo sai de uma leitura só, num mapa: as regras param em 1.000
    // expressões por avaliação, e reler o perfil a cada pergunta estourava
    function acesso() {
      let doc = temClaims() ? request.auth.token : meuDocumento();
      let ativo = temClaims() || doc.get('ativo', true) != false;
      let perf = eDemo() ? 'demo' : (ativo ? doc.get('perfil', null) : null);
      let interno = perf in ['supremo', 'gestor', 'aprovador', 'comprador', 'financeiro', 'solicitante', 'nenhum'];
      let serv = doc.get('servicos', null);
      let equip = doc.get('equipamentos', null);
      return {
        'perfil': perf,
        'supremo': perf == 'supremo',
        'compras': perf in ['supremo', 'gestor', 'aprovador', 'comprador', 'financeiro', 'solicitante'],
        'serv': perf == 'supremo' ? 'gestor' : (interno && serv in ['solicitante', 'financeiro', 'gestor'] ? serv : null),
        'equip': perf == 'supremo' ? 'gestor' : (interno && equip in ['consulta', 'responsavel', 'gestor'] ? equip : null),
        'forn': perf == 'prestador' ? doc.get('fornecedorId', '') : '',
        'padm': perf == 'prestador' && doc.get('fornecedorId', '') != '' && doc.get('prestadorAdmin', false) == true,
        'empresas': doc.get('empresas', [])
      };
    }
    function alcanca(a, empresaId) { return a.supremo || empresaId in a.empresas; }
    function ePrestador() { return estaLogado() && acesso().forn != ''; }
    function meuFornecedor() { return acesso().forn; }
    function ePrestadorAdmin() { return estaLogado() && acesso().padm; }
    function usaServicos() { return estaLogado() && acesso().serv != null; }
    function usaEquip() { return estaLogado() && acesso().equip != null; }
    function gestorServicos() { return estaLogado() && acesso().serv == 'gestor'; }
    function gestorEquip() { return estaLogado() && acesso().equip == 'gestor'; }
    function mexeEquip() { return estaLogado() && acesso().equip in ['responsavel', 'gestor']; }
    // Pessoa da empresa com algum módulo (lê empresas, unidades e cadastros)
    function deDentro() {
      let a = acesso();
      return estaLogado() && (a.compras || a.serv != null || a.equip != null);
    }
    // Quem cuida das unidades: quem administra (Compras) e os gestores dos outros módulos
    function cuidaDasUnidades() {
      let a = acesso();
      return estaLogado() && (a.perfil in ['supremo', 'gestor'] || a.serv == 'gestor' || a.equip == 'gestor');
    }

    function empresasDoUsuario() {
      return temClaims() ? request.auth.token.get('empresas', []) : meuDocumento().get('empresas', []);
    }

    function temAcessoEmpresa(empresaId) {
      return empresaId in empresasDoUsuario();
    }

    function eSupremo() { return perfil() == 'supremo'; }
    function eGestor()  { return perfil() in ['supremo', 'gestor']; }
    function eAprovador() { return perfil() in ['supremo', 'gestor', 'aprovador']; }
    function eComprador() { return perfil() in ['supremo', 'gestor', 'comprador']; }
    function eFinanceiro() { return perfil() in ['supremo', 'gestor', 'financeiro']; }

    // O supremo alcança todas as empresas; os outros, as do próprio perfil
    function alcancaEmpresa(empresaId) {
      return eSupremo() || temAcessoEmpresa(empresaId);
    }

    function eu() { return request.auth.uid; }
    function mudouSo(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Datas no formato aaaa-mm-dd (ou vazias): vale para todos, demo inclusive,
    // porque o app as mostra na tela
    function dataOk(campo) {
      return request.resource.data.get(campo, null) == null ||
        request.resource.data.get(campo, null).matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function pedidoValido() {
      return request.resource.data.status in
          ['solicitado', 'ag_cotacao', 'em_aprovacao', 'aprovado', 'comprado', 'entregue', 'pago', 'reprovado', 'cancelado'] &&
        dataOk('dataNecessaria') && dataOk('dataCompra') && dataOk('dataEntrega') &&
        // Itens (Fase 1): uma lista de até 30
        (request.resource.data.get('itens', null) == null ||
          (request.resource.data.itens is list && request.resource.data.itens.size() <= 30));
    }

    // ── Usuários ───────────────────────────────────────────────
    // ── Auditoria: a gravação administrativa vem com o seu registro ──
    // Mudança em usuário, convite, empresa, categoria e fornecedor (pelo
    // cadastro) só passa no mesmo lote que um registro novo em /auditoria,
    // que aponta para ela. Ao criar ou editar, o documento leva auditoriaId
    // (um ID novo a cada mudança); ao apagar, o registro tem ID fixo:
    // apagou-{entidade}-{id}-{auditoriaId de antes}. O registro é assinado
    // por quem grava (regras em /auditoria)
    function caminhoAuditoria(aid) { return /databases/$(database)/documents/auditoria/$(aid); }
    function registroNovo(aid, entidade, id) {
      return !exists(caminhoAuditoria(aid)) && existsAfter(caminhoAuditoria(aid)) &&
        getAfter(caminhoAuditoria(aid)).data.entidade == entidade &&
        getAfter(caminhoAuditoria(aid)).data.entidadeId == id;
    }
    function auditada(entidade, id) {
      let aid = request.resource.data.get('auditoriaId', '');
      return aid is string && aid.size() > 0 &&
        (resource == null || aid != resource.data.get('auditoriaId', '')) &&
        registroNovo(aid, entidade, id);
    }
    function auditadaAoApagar(entidade, id) {
      return registroNovo('apagou-' + entidade + '-' + id + '-' + resource.data.get('auditoriaId', '0'), entidade, id);
    }

    match /auditoria/{registroId} {
      // A hora é a do servidor; só o exemplo da demo (renovado todo dia) traz
      // a data do passado que ele conta
      function registroValido(horaDoServidor) {
        let d = request.resource.data;
        return d.keys().hasOnly(['autorId', 'autorNome', 'em', 'entidade', 'entidadeId', 'nome', 'acao',
            'antes', 'depois', 'empresaIds', 'isDemo']) &&
          d.autorId == eu() && d.em is timestamp && (!horaDoServidor || d.em == request.time) &&
          d.entidade in ['usuario', 'convite', 'empresa', 'categoria', 'fornecedor', 'alcada', 'unidade'] &&
          d.entidadeId is string && d.acao in ['criar', 'editar', 'apagar'] &&
          d.empresaIds is list && d.empresaIds.size() <= 30 &&
          (!registroId.matches('apagou-.*') ||
            (d.acao == 'apagar' && registroId.matches('apagou-' + d.entidade + '-.*')));
      }
      // O supremo lê tudo; o gestor, o que toca as empresas dele (a consulta
      // filtra por empresaIds); a demo, só o da demo
      allow read: if (temPerfil() && (eSupremo() ||
          (eGestor() && resource.data.empresaIds.hasAny(empresasDoUsuario())))) ||
        (eDemo() && marcadoDemo(resource.data));
      // Os módulos: quem cuida das unidades registra a unidade; o gestor de
      // Serviços, a ficha da prestadora; a conta da prestadora, os técnicos dela
      function registraModulo(entidade) {
        let a = acesso();
        return (entidade == 'unidade' && (a.perfil in ['supremo', 'gestor'] || a.serv == 'gestor' || a.equip == 'gestor')) ||
          (entidade == 'fornecedor' && a.serv == 'gestor') || (entidade == 'usuario' && a.padm);
      }
      allow create: if
        (temPerfil() && eGestor() && !marcadoDemo(request.resource.data) && registroValido(true)) ||
        (estaLogado() && !eDemo() && !marcadoDemo(request.resource.data) && registroValido(true) &&
          registraModulo(request.resource.data.entidade)) ||
        (eDemo() && marcadoDemo(request.resource.data) && registroValido(false));
      // Não se altera nem se apaga; a demo renova os registros dela
      allow update: if false;
      allow delete: if eDemo() && marcadoDemo(resource.data);
    }

    match /usuarios/{userId} {
      // Quem não é supremo não cria, edita nem promove ninguém a supremo, e só
      // dá acesso às empresas que ele mesmo tem
      function semPromover() {
        return eSupremo() || (
          request.resource.data.get('perfil', '') != 'supremo' &&
          (resource == null || resource.data.get('perfil', '') != 'supremo') &&
          request.resource.data.get('empresas', []).hasOnly(empresasDoUsuario())
        );
      }

      // Os papéis por módulo (js/modulos.js): Compras no perfil (ou 'nenhum'),
      // Serviços e Equipamentos nos campos próprios; o prestador aponta para
      // uma prestadora que existe e não tem os outros módulos
      function usuarioValido() {
        let d = request.resource.data;
        return d.get('perfil', '') in ['supremo', 'gestor', 'aprovador', 'comprador', 'financeiro', 'solicitante', 'nenhum', 'prestador'] &&
          d.get('servicos', null) in [null, 'solicitante', 'financeiro', 'gestor'] &&
          d.get('equipamentos', null) in [null, 'consulta', 'responsavel', 'gestor'] &&
          (d.get('perfil', '') != 'prestador' || (
            d.get('fornecedorId', '') is string && d.get('fornecedorId', '') != '' &&
            exists(/databases/$(database)/documents/fornecedores/$(d.get('fornecedorId', '-'))) &&
            d.get('servicos', null) == null && d.get('equipamentos', null) == null)) &&
          (d.get('perfil', '') == 'prestador' || (d.get('fornecedorId', null) == null && d.get('prestadorAdmin', false) == false));
      }
      // A conta da prestadora (prestadorAdmin) cuida dos técnicos dela: só
      // prestador, da mesma prestadora, nas empresas dela, sem virar conta da
      // prestadora, e nunca a si mesma
      function tecnicoDaMinhaPrestadora() {
        let a = acesso();
        let d = request.resource.data;
        return estaLogado() && a.padm && request.auth.uid != userId &&
          d.get('perfil', '') == 'prestador' && d.get('fornecedorId', '') == a.forn &&
          d.get('prestadorAdmin', false) == false && d.get('empresas', []).hasOnly(a.empresas) &&
          d.get('servicos', null) == null && d.get('equipamentos', null) == null &&
          (resource == null || (resource.data.get('fornecedorId', '') == a.forn &&
            resource.data.get('perfil', '') == 'prestador' && resource.data.get('prestadorAdmin', false) == false));
      }
      function leTecnico() {
        let a = acesso();
        return a.padm && resource.data.get('fornecedorId', '') == a.forn;
      }

      // O gestor só alcança quem é das empresas dele: lê quem tem ao menos
      // uma em comum e só edita quem está inteiro dentro delas (assim ele não
      // puxa para a sua empresa, nem muda o perfil de, alguém de outra)
      function mesmaEmpresa() {
        return resource.data.get('empresas', []).hasAny(empresasDoUsuario());
      }
      function todoNasMinhasEmpresas() {
        return mesmaEmpresa() && resource.data.get('empresas', []).hasOnly(empresasDoUsuario());
      }

      // A conta demo: as pessoas da demonstração (IDs "demo-…", marcadas), o
      // próprio perfil (perfil 'demo', que não dá permissão nenhuma) e os
      // perfis antigos dela mesma (de quando a conta foi recriada no console)
      function perfilDaContaDemo(dados) {
        return dados.get('email', '') == 'demo@praxis.app';
      }
      function demoGravaUsuario() {
        return eDemo() && (
          (idDemo(userId) && marcadoDemo(request.resource.data) &&
            (resource == null || marcadoDemo(resource.data))) ||
          (request.auth.uid == userId && resource == null &&
            perfilDaContaDemo(request.resource.data) &&
            request.resource.data.get('perfil', '') == 'demo') ||
          (request.auth.uid == userId && resource != null &&
            mudouSo(['empresas', 'atualizadoEm', 'ultimoAcesso']))
        );
      }

      // Primeiro acesso de quem foi convidado: a própria pessoa, com o e-mail
      // confirmado, cria o seu perfil copiando o convite (/convites/{e-mail})
      // campo a campo, enquanto ele vale. O app apaga o convite no mesmo lote.
      function caminhoConvite() {
        return /databases/$(database)/documents/convites/$(request.auth.token.get('email', '').lower());
      }
      function aceitaConvite() {
        return request.auth.uid == userId && !eDemo() && emailConfirmado() &&
          request.auth.token.get('email', '') != '' &&
          exists(caminhoConvite()) &&
          get(caminhoConvite()).data.expiraEm > request.time &&
          request.resource.data.keys().hasOnly(
            ['nome', 'email', 'perfil', 'empresas', 'ativo', 'convidadoPor', 'criadoEm', 'ultimoAcesso',
             'servicos', 'equipamentos', 'fornecedorId', 'prestadorAdmin']) &&
          request.resource.data.get('servicos', null) == get(caminhoConvite()).data.get('servicos', null) &&
          request.resource.data.get('equipamentos', null) == get(caminhoConvite()).data.get('equipamentos', null) &&
          request.resource.data.get('fornecedorId', null) == get(caminhoConvite()).data.get('fornecedorId', null) &&
          request.resource.data.get('prestadorAdmin', false) == get(caminhoConvite()).data.get('prestadorAdmin', false) &&
          request.resource.data.get('nome', '') == get(caminhoConvite()).data.nome &&
          request.resource.data.get('email', '') == get(caminhoConvite()).data.email &&
          request.resource.data.get('perfil', '') == get(caminhoConvite()).data.perfil &&
          request.resource.data.get('empresas', []) == get(caminhoConvite()).data.empresas &&
          request.resource.data.get('ativo', false) == get(caminhoConvite()).data.ativo &&
          request.resource.data.get('convidadoPor', '') == get(caminhoConvite()).data.criadoPor;
      }

      allow read: if estaLogado() && (
        request.auth.uid == userId || eSupremo() ||
        (temPerfil() && eGestor() && mesmaEmpresa()) || leTecnico() ||
        (eDemo() && (marcadoDemo(resource.data) || perfilDaContaDemo(resource.data)))
      );
      allow create: if (temPerfil() && eGestor() && semPromover() && usuarioValido() && auditada('usuario', userId)) ||
        (tecnicoDaMinhaPrestadora() && auditada('usuario', userId)) ||
        demoGravaUsuario() || aceitaConvite();
      // O próprio usuário só registra o último acesso: perfil e empresas valem
      // como permissão (no token, pela setUserClaims, ou lidos daqui pelas
      // regras) e não podem ser mudados por ele
      allow update: if estaLogado() && (
        (request.auth.uid == userId && !eDemo() && (mudouSo(['ultimoAcesso']) ||
          // A3: quem entrou com a senha inicial marca que já trocou
          (mudouSo(['trocarSenha']) && request.resource.data.trocarSenha == false))) ||
        (temPerfil() && eGestor() && request.auth.uid != userId &&
          (eSupremo() || todoNasMinhasEmpresas()) && semPromover() && usuarioValido() && auditada('usuario', userId)) ||
        (eSupremo() && usuarioValido() && auditada('usuario', userId)) ||
        (tecnicoDaMinhaPrestadora() && auditada('usuario', userId)) || demoGravaUsuario()
      );
      allow delete: if estaLogado() && (
        (eSupremo() && auditadaAoApagar('usuario', userId)) ||
        (eDemo() && request.auth.uid != userId && perfilDaContaDemo(resource.data))
      );
    }

    // ── Convites ───────────────────────────────────────────────
    // Quem administra convida pelo e-mail (o ID é o e-mail em minúsculas), com
    // perfil, empresas e prazo de até 60 dias. No primeiro acesso, a pessoa cria
    // o próprio perfil a partir do convite (aceitaConvite, em /usuarios) e o
    // apaga. O e-mail do token só vale confirmado (emailConfirmado): quem foi
    // convidado cria a própria conta de login, e o convite não se mostra a
    // quem ainda não provou ser dono do e-mail.
    match /convites/{email} {
      function meuEmail() { return request.auth.token.get('email', '').lower(); }
      function conviteValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(
            ['email', 'nome', 'perfil', 'empresas', 'ativo', 'criadoPor', 'criadoPorNome', 'criadoEm', 'expiraEm', 'auditoriaId',
             'servicos', 'equipamentos', 'fornecedorId', 'prestadorAdmin']) &&
          d.email == email && email == email.lower() && email.matches('^[^@/ ]+@[^@/ ]+$') &&
          d.nome is string && d.nome.size() > 0 && d.nome.size() <= 80 &&
          d.perfil in ['supremo', 'gestor', 'aprovador', 'comprador', 'financeiro', 'solicitante', 'nenhum', 'prestador'] &&
          d.get('servicos', null) in [null, 'solicitante', 'financeiro', 'gestor'] &&
          d.get('equipamentos', null) in [null, 'consulta', 'responsavel', 'gestor'] &&
          (d.perfil != 'prestador' || (d.get('fornecedorId', '') != '' &&
            exists(/databases/$(database)/documents/fornecedores/$(d.get('fornecedorId', '-'))) &&
            d.get('servicos', null) == null && d.get('equipamentos', null) == null)) &&
          d.empresas is list && d.ativo == true &&
          d.criadoPor == request.auth.uid &&
          d.expiraEm is timestamp && d.expiraEm > request.time &&
          d.expiraEm < request.time + duration.value(61, 'd') &&
          (eSupremo() || (d.perfil != 'supremo' && d.empresas.size() > 0 &&
            d.empresas.hasOnly(empresasDoUsuario())));
      }
      // O gestor alcança os convites inteiros dentro das empresas dele (como
      // nos usuários); o supremo, todos
      function conviteDoGestor() {
        return eSupremo() || (eGestor() &&
          resource.data.get('perfil', '') != 'supremo' &&
          resource.data.get('empresas', []).hasOnly(empresasDoUsuario()));
      }

      allow read: if estaLogado() && (
        (meuEmail() == email && emailConfirmado()) ||
        (temPerfil() && (eSupremo() || (eGestor() &&
          resource.data.get('empresas', []).hasAny(empresasDoUsuario()))))
      );
      allow create: if temPerfil() && eGestor() && conviteValido() && auditada('convite', email);
      allow update: if temPerfil() && eGestor() && conviteDoGestor() && conviteValido() && auditada('convite', email);
      allow delete: if estaLogado() && (
        (temPerfil() && conviteDoGestor() && auditadaAoApagar('convite', email)) ||
        (meuEmail() == email && emailConfirmado() && existsAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)))
      );
    }

    // ── Empresas ───────────────────────────────────────────────
    // O gestor só edita as empresas a que tem acesso
    match /empresas/{empresaId} {
      function leEmpresa() {
        let a = acesso();
        return estaLogado() && (a.compras || a.serv != null || a.equip != null || (a.forn != '' && empresaId in a.empresas));
      }
      allow read:   if temPerfil() || leEmpresa() || leDemo();
      allow create: if (temPerfil() && eGestor() && auditada('empresa', empresaId)) || gravaDemo(empresaId);
      allow update: if (temPerfil() && (eSupremo() || (eGestor() && temAcessoEmpresa(empresaId))) &&
        auditada('empresa', empresaId)) || gravaDemo(empresaId);
      allow delete: if temPerfil() && eSupremo() && auditadaAoApagar('empresa', empresaId);
    }

    // ── Alçadas de aprovação ───────────────────────────────────
    // Uma por empresa (o ID é o da empresa): faixas de valor em ordem, a
    // última sem teto, cada uma com 1 a 3 níveis em sequência (quem aprova,
    // por perfil ou por pessoa, e quantas aprovações o nível pede). Muda só
    // o gestor da empresa ou o supremo, com o registro da auditoria. Os
    // pedidos guardam o retrato da faixa ao entrar em aprovação (abaixo).
    match /alcadas/{empresaId} {
      // Faixa i de n: de 1 a 3 níveis; a última sem teto, as outras com teto
      // acima da anterior. O conteúdo de cada nível (nome, perfis, pessoas e
      // aprovações) é conferido pelo app (js/alcadas.js): conferir nível a
      // nível passa das 1.000 expressões que as regras avaliam por gravação
      // (medido no emulador: três faixas de três níveis já não cabem). Um nível
      // malformado não abre brecha: o voto confere perfil, pessoa e número de
      // aprovações no retrato, e o gestor ainda cancela o pedido
      function faixaOk(fs, i) {
        return fs.size() <= i || (
          fs[i].keys().hasOnly(['ate', 'niveis']) && fs[i].niveis is list &&
          fs[i].niveis.size() >= 1 && fs[i].niveis.size() <= 3 &&
          (i == fs.size() - 1 ? fs[i].ate == null :
            ((fs[i].ate is int || fs[i].ate is float) && fs[i].ate > 0 && (i == 0 || fs[i].ate > fs[i - 1].ate))));
      }
      function alcadaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['faixas', 'auditoriaId', 'atualizadoEm', 'isDemo']) &&
          d.faixas is list && d.faixas.size() >= 1 && d.faixas.size() <= 6 &&
          faixaOk(d.faixas, 0) && faixaOk(d.faixas, 1) && faixaOk(d.faixas, 2) &&
          faixaOk(d.faixas, 3) && faixaOk(d.faixas, 4) && faixaOk(d.faixas, 5);
      }
      function daEmpresaDaAlcada() {
        return temPerfil() && (eSupremo() || (eGestor() && temAcessoEmpresa(empresaId)));
      }
      allow read:   if temPerfil() || leDemo();
      allow create, update: if (daEmpresaDaAlcada() && alcadaValida() && !marcadoDemo(request.resource.data) &&
        auditada('alcada', empresaId)) || gravaDemo(empresaId);
      allow delete: if (daEmpresaDaAlcada() && auditadaAoApagar('alcada', empresaId)) || leDemo();
    }

    // ── Categorias ─────────────────────────────────────────────
    match /categorias/{catId} {
      allow read:   if temPerfil() || deDentro() || leDemo();
      allow create: if (temPerfil() && eGestor() && auditada('categoria', catId)) || gravaDemo(catId);
      allow update: if (temPerfil() && eGestor() && auditada('categoria', catId)) || gravaDemo(catId);
      allow delete: if temPerfil() && eSupremo() && auditadaAoApagar('categoria', catId);
    }

    // ── Fornecedores ───────────────────────────────────────────
    // Nasce na cotação ou na compra (fica no histórico do pedido, que soma
    // os usos); a edição pelo cadastro e a remoção vão para a auditoria
    match /fornecedores/{fornId} {
      function leFornecedor() {
        let a = acesso();
        return estaLogado() && (a.compras || a.serv != null || a.equip != null || a.forn == fornId);
      }
      allow read:   if temPerfil() || leFornecedor() || leDemo();
      allow create: if (temPerfil() && eComprador()) || gravaDemo(fornId);
      // O gestor de Serviços configura só os serviços contratados da
      // prestadora (frequência, prazo e unidades), com o registro da auditoria
      allow update: if (temPerfil() && (eComprador() || eGestor()) &&
        (mudouSo(['usos']) || auditada('fornecedor', fornId))) || gravaDemo(fornId) ||
        (gestorServicos() && mudouSo(['servicosContratados', 'auditoriaId', 'atualizadoEm']) &&
          request.resource.data.servicosContratados is list && request.resource.data.servicosContratados.size() <= 30 &&
          auditada('fornecedor', fornId));
      allow delete: if (temPerfil() && eGestor() && auditadaAoApagar('fornecedor', fornId)) || leDemo();
    }

    // ── Metadados internos ─────────────────────────────────────
    // Contador do número do pedido (PRX-0001…): quem abre um pedido soma 1
    match /_meta/contadores {
      allow read: if temPerfil();
      allow create, update: if temPerfil() && (eSupremo() || (
        request.resource.data.keys().hasOnly(['totalPedidos']) &&
        request.resource.data.totalPedidos ==
          (resource == null ? 0 : resource.data.get('totalPedidos', 0)) + 1
      ));
    }
    // Contador próprio da demo: a conta demo não mexe na numeração real
    match /_meta/contadoresDemo {
      allow read, write: if eDemo();
    }
    // Trava e dia da renovação da demo: só a conta demo
    match /_meta/demo {
      allow read, write: if eDemo();
    }

    // ── Pedidos já abertos por cada conta ("visto por") ─────────
    // Um documento por conta, que só ela lê e grava: o mapa pedidos → quando
    // abriu. Antes a marca ficava no próprio pedido, e cada abertura fazia
    // todo quadro aberto reler o pedido
    match /lidos/{uid} {
      allow read, delete: if estaLogado() && eu() == uid;
      allow create, update: if estaLogado() && eu() == uid &&
        request.resource.data.keys().hasOnly(['pedidos']) &&
        request.resource.data.pedidos is map &&
        request.resource.data.pedidos.size() <= 20000;
    }

    // ── Pedidos ────────────────────────────────────────────────
    match /pedidos/{pedidoId} {
      // Cada passo do caminho, com quem pode dá-lo e o que pode mudar
      // (o mesmo que o app mostra em js/pedido-detalhe.js e js/pedidos.js).
      // Vale para todos os perfis, o supremo inclusive: ele age como um gestor
      // de todas as empresas, sem pular etapas. Só a separação de funções e a
      // alçada não valem para ele (livre(), abaixo): é o usuário máximo, da
      // equipe que desenvolve o sistema
      function de(st0, st1) {
        return resource.data.status == st0 && request.resource.data.status == st1;
      }
      function oComprador() {
        return resource.data.get('compradorId', null) == eu() || eGestor();
      }
      function oSolicitante() { return resource.data.get('solicitanteId', null) == eu(); }
      // Separação de funções: quem abriu ou cotou o pedido não decide sobre
      // ele, e quem o aprovou não registra a compra nem o pagamento. O supremo
      // fica livre dessas travas e da alçada
      function livre()   { return eSupremo(); }
      function cotou()   { return resource.data.get('compradorId', null) == eu(); }
      // Aprovou: decidiu sozinho ou votou em algum nível da alçada
      function aprovou() {
        return resource.data.get('aprovadoPor', null) == eu() ||
          eu() in resource.data.get(['aprovacao', 'votos', '0'], []) ||
          eu() in resource.data.get(['aprovacao', 'votos', '1'], []) ||
          eu() in resource.data.get(['aprovacao', 'votos', '2'], []);
      }

      // ── Alçada (ver /alcadas) ──
      // Ao entrar em aprovação, o pedido de empresa com alçada guarda o retrato
      // da faixa em que cai o valor da cotação indicada: a faixa, o valor, os
      // níveis iguais aos da alçada, o primeiro nível e nenhum voto; e a fila
      // (aprovadorIds) com as pessoas do primeiro nível. Sem alçada, nada disso
      function caminhoAlcada() {
        return /databases/$(database)/documents/alcadas/$(resource.data.empresaId);
      }
      function retratoDaAlcada() {
        let d = request.resource.data;
        let a = d.get('aprovacao', null);
        let fs = get(caminhoAlcada()).data.faixas;
        let valor = getAfter(caminhoCotacao(d.cotacaoIndicadaId)).data.valor;
        return a is map && a.keys().hasOnly(['faixa', 'valor', 'niveis', 'nivelAtual', 'votos']) &&
          a.faixa is int && a.faixa >= 0 && a.faixa < fs.size() && a.valor == valor &&
          (fs[a.faixa].ate == null || valor <= fs[a.faixa].ate) &&
          (a.faixa == 0 || valor > fs[a.faixa - 1].ate) &&
          a.niveis == fs[a.faixa].niveis && a.nivelAtual == 0 && a.votos == {} &&
          d.get('aprovadorIds', []) == fs[a.faixa].niveis[0].usuarios;
      }
      function temAlcada() { return resource.data.get('aprovacao', null) != null; }

      // ── Opções da empresa (Fase 2) ──
      // requisicao: { ativa, limite } (R4, pedir sem cotação) e autoAprovacao:
      // { ativa, limite } (A4, quem pede aprova o próprio pedido até o limite).
      // Limite null é sem limite
      function caminhoEmpresa(id) { return /databases/$(database)/documents/empresas/$(id); }
      function opcaoDaEmpresa(id, opcao) {
        return get(caminhoEmpresa(id)).data.get(opcao, {});
      }
      function cabeNoLimite(op, valor) {
        return op.get('ativa', false) == true &&
          (op.get('limite', null) == null || (valor is number && valor <= op.limite));
      }
      // O valor que conta para a aprovação: o estimado da requisição ou o da
      // cotação indicada
      function valorEmAprovacao() {
        return resource.data.get('requisicao', false) == true
          ? resource.data.get('valorEstimado', null)
          : get(caminhoCotacao(resource.data.get('cotacaoIndicadaId', '-'))).data.get('valor', null);
      }
      // A4: quem abriu aprova o próprio pedido (sem alçada) se a empresa deixa
      function autoAprova() {
        return oSolicitante() && !cotou() &&
          cabeNoLimite(opcaoDaEmpresa(resource.data.empresaId, 'autoAprovacao'), valorEmAprovacao());
      }
      // Vota no nível atual quem está nele (pelo perfil ou pelo nome), não abriu
      // nem cotou o pedido e não votou em nenhum nível; o supremo, sempre
      function noNivelAtual() {
        let a = resource.data.aprovacao;
        let nv = a.niveis[a.nivelAtual];
        return livre() || (eAprovador() && !oSolicitante() && !cotou() && !aprovou() &&
          (eu() in nv.usuarios || perfil() in nv.perfis));
      }
      // O voto entra na lista do nível. Se o nível completa, o pedido passa ao
      // seguinte (com a fila dele) ou, no último, fica aprovado. O voto do
      // supremo aprova o pedido de uma vez, em qualquer nível
      function votar() {
        let a0 = resource.data.aprovacao;
        let a1 = request.resource.data.get('aprovacao', {});
        let n = a0.nivelAtual;
        let k = string(n);
        let votos = a0.votos.get(k, []).concat([eu()]);
        let completo = votos.size() >= a0.niveis[n].minimo && !livre();
        let ultimo = n == a0.niveis.size() - 1;
        let fecha = livre() || (votos.size() >= a0.niveis[n].minimo && ultimo);
        return resource.data.status == 'em_aprovacao' && noNivelAtual() &&
          a1.diff(a0).affectedKeys().hasOnly(['votos', 'nivelAtual']) &&
          a1.votos.diff(a0.votos).affectedKeys().hasOnly([k]) && a1.votos[k] == votos && (
            (!completo && !fecha && a1.nivelAtual == n && request.resource.data.status == 'em_aprovacao' &&
              mudouSo(['aprovacao', 'atualizadoEm'])) ||
            (completo && !ultimo && a1.nivelAtual == n + 1 && request.resource.data.status == 'em_aprovacao' &&
              request.resource.data.get('aprovadorIds', []) == a0.niveis[n + 1].usuarios &&
              mudouSo(['aprovacao', 'aprovadorIds', 'atualizadoEm'])) ||
            (fecha && a1.nivelAtual == n && request.resource.data.status == 'aprovado' &&
              request.resource.data.aprovadoPor == eu() &&
              mudouSo(['status', 'aprovacao', 'aprovadorIds', 'aprovadoPor', 'aprovadoPorNome', 'aprovadoEm', 'atualizadoEm']))
          );
      }

      // Reprovar e cancelar exigem o motivo da lista e, em "Outros", o texto
      function motivoDado(campo, campoOutros) {
        let motivo = request.resource.data.get(campo, null);
        let outros = request.resource.data.get(campoOutros, null);
        return motivo is string && motivo.trim().size() > 0 &&
          (motivo != 'Outros' || (outros is string && outros.trim().size() > 0));
      }

      // Para ir a "Em aprovação", o pedido aponta a cotação indicada
      // (cotacaoIndicadaId): ela já existia e sai do lote marcada como indicada
      function caminhoCotacao(id) {
        return /databases/$(database)/documents/pedidos/$(pedidoId)/cotacoes/$(id);
      }
      function cotacaoIndicadaValida() {
        let id = request.resource.data.get('cotacaoIndicadaId', null);
        return id is string && id.size() > 0 && exists(caminhoCotacao(id)) &&
          getAfter(caminhoCotacao(id)).data.get('indicada', false) == true &&
          getAfter(caminhoCotacao(id)).data.get('semProduto', false) != true;
      }
      // Com uma cotação só, o comprador diz por quê (o app pede; aqui, o formato)
      function motivoCotacaoUnicaOk() {
        let m = request.resource.data.get('motivoCotacaoUnica', null);
        return m == null || (m is string && m.size() <= 300);
      }

      // O pedido reaberto traz a justificativa de quem o reabriu
      function reaberturaJustificada() {
        let justificativa = request.resource.data.get('justificativaReabertura', null);
        return request.resource.data.get('reabertoDe', null) == null ||
          (justificativa is string && justificativa.trim().size() > 0);
      }

      // Entrada do histórico gravada no mesmo lote (ou transação) que a
      // mudança: não existia antes e passa a existir, do tipo certo e assinada
      // por quem grava. A edição do pedido e o comprovante da parcela apontam
      // para ela (ultimaEdicaoId, comprovanteEventoId); a cotação e o anexo
      // usam o próprio ID na entrada. Sem ela, a gravação é recusada.
      function caminhoHistorico(id) {
        return /databases/$(database)/documents/pedidos/$(pedidoId)/historico/$(id);
      }
      function registraNoHistorico(id, tipo) {
        return id is string && id.size() > 0 &&
          !exists(caminhoHistorico(id)) && existsAfter(caminhoHistorico(id)) &&
          getAfter(caminhoHistorico(id)).data.get('tipo', '') == tipo &&
          getAfter(caminhoHistorico(id)).data.get('autorId', '') == eu();
      }

      // Data do último comentário. O "visto por" saiu do pedido: fica em
      // lidos/{uid}, abaixo
      function comentou() { return mudouSo(['ultimoComentarioEm']); }

      function assumir() {
        return de('solicitado', 'ag_cotacao') && eComprador() &&
          resource.data.get('compradorId', null) == null &&
          request.resource.data.compradorId == eu() &&
          mudouSo(['status', 'compradorId', 'compradorNome', 'compradorAssumiuEm', 'atualizadoEm']);
      }
      function liberar() {
        return de('ag_cotacao', 'solicitado') && eGestor() &&
          request.resource.data.compradorId == null &&
          mudouSo(['status', 'compradorId', 'compradorNome', 'compradorAssumiuEm', 'atualizadoEm']);
      }
      function indicarCotacao() {
        return de('ag_cotacao', 'em_aprovacao') && eComprador() && oComprador() &&
          cotacaoIndicadaValida() && motivoCotacaoUnicaOk() && (
            (!exists(caminhoAlcada()) && mudouSo(['status', 'cotacaoIndicadaId', 'motivoCotacaoUnica', 'atualizadoEm'])) ||
            (exists(caminhoAlcada()) && retratoDaAlcada() &&
              mudouSo(['status', 'cotacaoIndicadaId', 'motivoCotacaoUnica', 'aprovacao', 'aprovadorIds', 'atualizadoEm']))
          );
      }
      // Quem abriu ou cotou o pedido não decide sobre ele. Com alçada, a
      // aprovação é por votos (votar); reprovar, quem está no nível atual
      function aprovar() {
        return de('em_aprovacao', 'aprovado') && !temAlcada() && eAprovador() &&
          (livre() || (!oSolicitante() && !cotou()) || autoAprova()) &&
          request.resource.data.aprovadoPor == eu() &&
          mudouSo(['status', 'aprovadoPor', 'aprovadoPorNome', 'aprovadoEm', 'atualizadoEm']);
      }
      function reprovar() {
        return de('em_aprovacao', 'reprovado') && eAprovador() && (livre() || (!oSolicitante() && !cotou())) &&
          (!temAlcada() || noNivelAtual()) &&
          request.resource.data.reprovadoPor == eu() &&
          motivoDado('motivoReprovacao', 'motivoReprovacaoOutros') &&
          mudouSo(['status', 'reprovadoPor', 'reprovadoPorNome', 'reprovadoEm',
                   'motivoReprovacao', 'motivoReprovacaoOutros', 'atualizadoEm']);
      }
      // Quem aprovou não registra a compra nem o pagamento
      // S5: no mesmo passo, a compra que já chegou vai a "Entregue" e, para
      // quem é do financeiro, a que já foi paga vai a "Pago"
      function comprar() {
        let destino = request.resource.data.status;
        return resource.data.status == 'aprovado' && destino in ['comprado', 'entregue', 'pago'] &&
          (destino != 'pago' || eFinanceiro()) &&
          eComprador() && oComprador() && (livre() || !aprovou()) &&
          resource.data.get('requisicao', false) != true &&
          notaFiscalOk() &&
          mudouSo(['status', 'fornecedorId', 'fornecedorNome', 'valorFinal',
                   'condicaoPagamento', 'dataCompra', 'dataEntrega', 'notaFiscal', 'atualizadoEm']);
      }
      // R4: a requisição aprovada é registrada por quem foi buscar (quem pediu,
      // ou quem compra na empresa): o valor, a nota e quem retirou. Já chega
      // recebida ("Entregue"); "Pago" só para quem é do financeiro. Com a
      // autoaprovação, quem aprovou o próprio pedido também registra
      function registrarRequisicao() {
        let destino = request.resource.data.status;
        let r = request.resource.data.get('retiradoPor', null);
        return resource.data.get('requisicao', false) == true && resource.data.status == 'aprovado' &&
          destino in ['entregue', 'pago'] && (destino != 'pago' || eFinanceiro()) &&
          (oSolicitante() || (eComprador() && oComprador())) &&
          (livre() || !aprovou() || resource.data.get('aprovadoPor', null) == resource.data.solicitanteId) &&
          pessoaOk(r) && notaFiscalOk() &&
          request.resource.data.valorFinal is number && request.resource.data.valorFinal > 0 &&
          mudouSo(['status', 'fornecedorId', 'fornecedorNome', 'valorFinal', 'condicaoPagamento',
                   'dataCompra', 'dataEntrega', 'notaFiscal', 'retiradoPor', 'atualizadoEm']);
      }
      // R4: a requisição nasce em "Em aprovação", sem cotação, com o
      // fornecedor de sempre e o valor estimado dentro do limite da empresa
      function requisicaoValida() {
        let d = request.resource.data;
        return d.status == 'em_aprovacao' && d.get('requisicao', false) == true &&
          d.get('lancamento', null) == null &&
          (d.solicitanteId == eu() || eGestor()) &&
          d.valorEstimado is number && d.valorEstimado > 0 &&
          d.fornecedorNome is string && d.fornecedorNome.trim().size() > 0 && d.fornecedorNome.size() <= 120 &&
          d.get('compradorId', null) == null && d.get('cotacaoIndicadaId', null) == null &&
          d.get('aprovacao', null) == null && d.get('aprovadoPor', null) == null &&
          d.get('reabertoDe', null) == null &&
          cabeNoLimite(get(caminhoEmpresa(d.empresaId)).data.get('requisicao', {}), d.valorEstimado);
      }
      // Recebe o comprador responsável (ou um gestor) ou quem pediu. A compra
      // já feita que foi paga antes de chegar fecha o pedido ao ser recebida
      function receber() {
        let jaPago = resource.data.get(['lancamento', 'pago'], false) == true;
        return ((!jaPago && de('comprado', 'entregue')) || (jaPago && de('comprado', 'pago'))) &&
          ((eComprador() && oComprador()) || oSolicitante()) &&
          mudouSo(['status', 'dataEntrega', 'atualizadoEm']);
      }
      // Número ou chave de acesso da nota (até 60 caracteres)
      function notaFiscalOk() {
        let n = request.resource.data.get('notaFiscal', null);
        return n == null || (n is string && n.size() <= 60);
      }
      // A nota que chega depois da compra: quem comprou, quem pediu, o
      // financeiro ou um gestor informam, com a entrada do histórico
      function informarNota() {
        return resource.data.status in ['comprado', 'entregue', 'pago'] &&
          ((eComprador() && oComprador()) || oSolicitante() || eFinanceiro()) &&
          notaFiscalOk() && request.resource.data.get('notaFiscal', null) != null &&
          mudouSo(['notaFiscal', 'atualizadoEm', 'ultimaEdicaoId']) &&
          registraNoHistorico(request.resource.data.get('ultimaEdicaoId', ''), 'edicao');
      }

      // ── Compra já feita (lançamento) ──
      // Quem tem acesso à empresa registra uma compra que já aconteceu: o
      // pedido nasce em "Comprado" (ainda não chegou), "Entregue" (chegou, a
      // pagar) ou "Pago", em nome de quem lança, com quem pediu, quem
      // autorizou e quem comprou (pessoas do Praxis ou só o nome) e o motivo.
      // A autorização fica confirmada quando quem lança é quem autorizou; se
      // não, fica pendente até a pessoa (ou um gestor da empresa que não lançou)
      // confirmar ou negar. Nada de aprovação, alçada ou cotação nesse caminho
      function pessoaOk(p) {
        return p is map && p.keys().hasOnly(['id', 'nome']) &&
          p.nome is string && p.nome.trim().size() > 0 && p.nome.size() <= 120 &&
          (p.get('id', null) == null || p.id is string);
      }
      function lancamentoValido() {
        let d = request.resource.data;
        let l = d.get('lancamento', null);
        // Só o gestor (ou o supremo) que autorizou a própria compra a lança
        // confirmada; os outros perfis passam pela revisão
        let euAutorizei = l.autorizadoPor.get('id', null) == eu() && eGestor();
        return l.keys().hasOnly(['lancadoPor', 'lancadoPorNome', 'pedidoPor', 'autorizadoPor', 'compradoPor',
            'motivo', 'recebido', 'pago', 'autorizacao', 'autorizacaoEm', 'autorizacaoPor', 'autorizacaoPorNome']) &&
          l.lancadoPor == eu() && d.solicitanteId == eu() &&
          pessoaOk(l.pedidoPor) && pessoaOk(l.autorizadoPor) && pessoaOk(l.compradoPor) &&
          l.motivo is string && l.motivo.trim().size() > 0 && l.motivo.size() <= 500 &&
          l.recebido is bool && l.pago is bool &&
          d.status == (l.recebido ? (l.pago ? 'pago' : 'entregue') : 'comprado') &&
          ((euAutorizei && l.autorizacao == 'confirmada' && l.autorizacaoEm == request.time && l.autorizacaoPor == eu()) ||
           (!euAutorizei && l.autorizacao == 'pendente' && l.autorizacaoEm == null && l.autorizacaoPor == null)) &&
          d.valorFinal is number && d.valorFinal > 0 &&
          d.fornecedorNome is string && d.fornecedorNome.trim().size() > 0 &&
          d.get('compradorId', null) == l.compradoPor.get('id', null) &&
          d.get('aprovadoPor', null) == null && d.get('aprovacao', null) == null &&
          d.get('cotacaoIndicadaId', null) == null && d.get('reabertoDe', null) == null &&
          notaFiscalOk();
      }
      // Quem foi apontado como autorizador, ou um gestor da empresa, confirma
      // ou nega, uma vez, com a entrada do histórico; nunca quem lançou
      function revisarAutorizacao() {
        let l0 = resource.data.get('lancamento', null);
        let l1 = request.resource.data.get('lancamento', {});
        return l0 != null && l0.autorizacao == 'pendente' && l0.lancadoPor != eu() &&
          (l0.autorizadoPor.get('id', null) == eu() || eGestor()) &&
          l1.diff(l0).affectedKeys().hasOnly(['autorizacao', 'autorizacaoEm', 'autorizacaoPor', 'autorizacaoPorNome']) &&
          l1.autorizacao in ['confirmada', 'negada'] && l1.autorizacaoEm == request.time &&
          l1.autorizacaoPor == eu() &&
          mudouSo(['lancamento', 'atualizadoEm', 'autorizacaoEventoId']) &&
          registraNoHistorico(request.resource.data.get('autorizacaoEventoId', ''), 'autorizacao');
      }
      function pagar() {
        return de('entregue', 'pago') && eFinanceiro() && (livre() || !aprovou()) &&
          mudouSo(['status', 'atualizadoEm']);
      }
      function cancelar() {
        return request.resource.data.status == 'cancelado' && (
          (oSolicitante() && resource.data.status == 'solicitado') ||
          (eGestor() && !(resource.data.status in ['entregue', 'pago', 'reprovado', 'cancelado']))
        ) &&
          motivoDado('motivoCancelamento', 'motivoCancelamentoOutros') &&
          mudouSo(['status', 'canceladoPor', 'canceladoPorNome', 'canceladoEm',
                   'motivoCancelamento', 'motivoCancelamentoOutros', 'atualizadoEm']);
      }
      function editar() {
        return (
          (oSolicitante() && resource.data.status == 'solicitado') ||
          (eGestor() && !(resource.data.status in ['pago', 'reprovado', 'cancelado']))
        ) &&
          mudouSo(['titulo', 'descricao', 'valorEstimado', 'dataNecessaria',
                   'categoriaId', 'urgente', 'atualizadoEm', 'ultimaEdicaoId',
                   // Fase 1: os itens (com a quantidade e a unidade do
                   // primeiro), o desconto, o veículo e o centro de custo
                   'itens', 'quantidade', 'unidade', 'desconto', 'veiculo', 'centroCusto']) &&
          registraNoHistorico(request.resource.data.get('ultimaEdicaoId', ''), 'edicao');
      }
      function reabrir() {
        return resource.data.status == 'reprovado' &&
          resource.data.get('reabertoPara', null) == null &&
          (eGestor() || (perfil() == 'solicitante' && oSolicitante())) &&
          mudouSo(['reabertoPara', 'reabertaParaNum', 'atualizadoEm']);
      }

      // A marca isDemo nasce com o pedido e não muda: um pedido real nunca
      // vira demo (e a conta demo só apaga pedidos da demo)
      function mesmaMarcaDemo() {
        return marcadoDemo(request.resource.data) == marcadoDemo(resource.data);
      }

      allow get: if leDemo() || (temPerfil() && (
        eSupremo() || temAcessoEmpresa(resource.data.empresaId) ||
        resource.data.solicitanteId == eu()
      ));
      // A consulta precisa filtrar pelas empresas do usuário (ou, para o
      // solicitante, pelos pedidos dele); sem filtro, só o supremo lista.
      // A conta demo filtra por isDemo == true.
      allow list: if leDemo() || (temPerfil() && (
        eSupremo() || resource.data.empresaId in empresasDoUsuario() ||
        resource.data.solicitanteId == eu()
      ));
      // O pedido nasce em "Solicitado", aberto em nome próprio (o gestor e o
      // supremo também abrem em nome de outra pessoa), ou como compra já feita
      // (lancamentoValido, acima)
      allow create: if pedidoValido() && (
        (eDemo() && idDemo(pedidoId) && marcadoDemo(request.resource.data)) ||
        (temPerfil() && !idDemo(pedidoId) && !marcadoDemo(request.resource.data) &&
          alcancaEmpresa(request.resource.data.empresaId) && (
            (request.resource.data.get('lancamento', null) == null &&
              request.resource.data.status == 'solicitado' &&
              (request.resource.data.solicitanteId == eu() || eGestor()) &&
              reaberturaJustificada()) ||
            (request.resource.data.get('lancamento', null) is map && lancamentoValido()) ||
            requisicaoValida()
          ))
      );
      allow update: if pedidoValido() && mesmaMarcaDemo() && (
        leDemo() || (temPerfil() &&
          alcancaEmpresa(resource.data.empresaId) &&
          request.resource.data.empresaId == resource.data.empresaId && (
            comentou() || assumir() || liberar() || indicarCotacao() ||
            // O voto só é avaliado quando o pedido fica em aprovação ou é
            // aprovado: poupa expressões dos outros passos (limite de 1.000)
            aprovar() || (temAlcada() && request.resource.data.status in ['em_aprovacao', 'aprovado'] && votar()) ||
            reprovar() || comprar() || receber() || pagar() ||
            cancelar() || editar() || reabrir() || informarNota() || revisarAutorizacao() ||
            registrarRequisicao()
          ))
      );
      // Pedidos nunca são deletados (apenas cancelados), exceto os da demo na renovação
      allow delete: if leDemo();

      // Subcoleções: a área da demo vem primeiro e é decidida pelo ID do
      // pedido, sem ler o pedido-pai (a renovação grava em lote, e num lote as
      // regras podem ler no máximo 20 documentos)
      function areaDemo() { return eDemo() && idDemo(pedidoId); }
      function pai() {
        return get(/databases/$(database)/documents/pedidos/$(pedidoId)).data;
      }
      function veOPedido() {
        return eSupremo() || temAcessoEmpresa(pai().empresaId) || pai().solicitanteId == eu();
      }
      // A empresa do pedido é da pessoa (o supremo alcança todas)
      function daEmpresa() {
        return eSupremo() || temAcessoEmpresa(pai().empresaId);
      }
      // Quem grava assina com o próprio UID, o supremo também
      function autorSouEu() {
        return request.resource.data.autorId == eu();
      }
      // O comprador que assumiu o pedido (ou um gestor da empresa)
      function compradorDoPedido() {
        return pai().get('compradorId', null) == eu() || eGestor();
      }

      // ── Cotações ─────────────────────────────────────────────
      // Só o comprador que assumiu o pedido (ou um gestor da empresa) registra e
      // indica, e só enquanto o pedido está em cotação: depois, as propostas que
      // foram para a aprovação não mudam. A cotação nova vem com a entrada do
      // histórico de mesmo ID, no mesmo lote; a indicação muda só a marca
      match /cotacoes/{cotacaoId} {
        function emCotacao() { return pai().status == 'ag_cotacao'; }
        function cotaOPedido() {
          return eComprador() && daEmpresa() && compradorDoPedido() && emCotacao();
        }
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && cotaOPedido() &&
          registraNoHistorico(cotacaoId, 'cotacao'));
        allow update: if areaDemo() || (temPerfil() && cotaOPedido() && mudouSo(['indicada']));
        allow delete: if areaDemo() || (temPerfil() && eGestor() && daEmpresa() && emCotacao());
      }

      // ── Comentários e notas internas ──────────────────────────
      // Nasce sem edição. Só o autor edita, e só o texto: a edição grava
      // editadoEm (hora do servidor) e anexa o texto anterior a versoes, com a
      // data dele; as versões de antes não mudam (até 20). Apagar fica com o
      // gestor da empresa do pedido e o supremo
      function comentarioNovo() {
        return autorSouEu() && !request.resource.data.keys().hasAny(['versoes', 'editadoEm']);
      }
      function edicaoDoAutor() {
        let antes = resource.data.get('versoes', []);
        let depois = request.resource.data.get('versoes', []);
        let n = antes.size();
        return eu() == resource.data.autorId &&
          mudouSo(['texto', 'editadoEm', 'versoes']) &&
          request.resource.data.editadoEm == request.time &&
          depois.size() == n + 1 && depois.size() <= 20 &&
          (n == 0 || depois[0:n] == antes) &&
          depois[n].keys().hasOnly(['texto', 'em']) &&
          depois[n].texto == resource.data.texto &&
          depois[n].em == resource.data.get('editadoEm', resource.data.get('criadoEm', null));
      }
      match /comentarios/{comentarioId} {
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && veOPedido() && comentarioNovo());
        allow update: if areaDemo() || (temPerfil() && veOPedido() && edicaoDoAutor());
        allow delete: if areaDemo() || (temPerfil() && eGestor() && daEmpresa());
      }
      // Nota interna: a conversa da equipe de compras (preço, prazo,
      // negociação). O perfil solicitante não lê nem escreve; quem é da equipe
      // e abriu o próprio pedido continua vendo
      match /notasInternas/{notaId} {
        function daEquipe() { return perfil() != 'solicitante'; }
        allow read: if areaDemo() || (temPerfil() && daEquipe() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && daEquipe() && veOPedido() && comentarioNovo());
        allow update: if areaDemo() || (temPerfil() && daEquipe() && veOPedido() && edicaoDoAutor());
        allow delete: if areaDemo() || (temPerfil() && eGestor() && daEmpresa());
      }

      // ── Parcelas ──────────────────────────────────────────────
      // O financeiro registra o pagamento (pago, pagoEm) e anexa o comprovante,
      // menos quem aprovou o pedido (o supremo, sim); o comprovante vem com a
      // entrada do histórico, no mesmo lote
      // A compra já feita grava as parcelas na mesma transação em que o pedido
      // nasce, por quem lança (o pedido ainda não existe para as outras regras)
      function parcelaDoLancamento() {
        let caminho = /databases/$(database)/documents/pedidos/$(pedidoId);
        return temPerfil() && !exists(caminho) && existsAfter(caminho) &&
          getAfter(caminho).data.get(['lancamento', 'lancadoPor'], null) == eu();
      }
      match /parcelas/{parcelaId} {
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if parcelaDoLancamento() || areaDemo() || (temPerfil() && eComprador() && daEmpresa()) ||
          // A requisição: quem pediu registra a retirada com as parcelas
          (temPerfil() && pai().get('requisicao', false) == true && pai().solicitanteId == eu());
        allow update: if areaDemo() || (temPerfil() &&
          eFinanceiro() && daEmpresa() && (eSupremo() || pai().get('aprovadoPor', null) != eu()) && (
            mudouSo(['pago', 'pagoEm']) ||
            (mudouSo(['comprovante', 'comprovanteEventoId']) &&
              registraNoHistorico(request.resource.data.get('comprovanteEventoId', ''), 'comprovante'))
          ));
        allow delete: if areaDemo(); // só a renovação da demo
      }

      // ── Histórico ─────────────────────────────────────────────
      match /historico/{entradaId} {
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && veOPedido() && autorSouEu());
        allow update: if false; // Histórico é imutável
        allow delete: if areaDemo(); // só a renovação da demo
      }

      // ── Anexos gerais ─────────────────────────────────────────
      // O anexo novo vem com a entrada do histórico de mesmo ID, no mesmo lote;
      // apaga quem anexou ou um gestor da empresa do pedido
      match /anexos/{anexoId} {
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && veOPedido() && autorSouEu() &&
          registraNoHistorico(anexoId, 'anexo'));
        // Apaga um gestor da empresa (o supremo, de qualquer uma) ou quem
        // anexou, enquanto ainda vê o pedido
        allow delete: if areaDemo() || (temPerfil() && (
          (eGestor() && daEmpresa()) ||
          (request.auth.uid == resource.data.autorId && veOPedido())
        ));
        allow update: if false;
      }
    }

    // ══ Módulos Serviços e Equipamentos (27/11/2026) ═══════════════
    // Os mesmos princípios dos pedidos: cada passo tem dono e campos próprios;
    // nada muda sem a entrada do histórico no mesmo lote (ultimoEventoId aponta
    // para ela, assinada por quem grava); empresas isoladas; a demo só mexe no
    // que é dela (isDemo). Cada regra lê o acesso uma vez (acesso(), acima).
    // Espelho do app em js/servicos-regras.js e js/equip-regras.js.
    function caminhoUnidade(id) { return /databases/$(database)/documents/unidades/$(id); }
    function caminhoFornecedor(id) { return /databases/$(database)/documents/fornecedores/$(id); }

    // Toda mudança aponta (ultimoEventoId, um ID novo) para a entrada do
    // histórico gravada no mesmo lote, assinada por quem grava
    function eventoNovo(colecao, id) {
      let eid = request.resource.data.get('ultimoEventoId', '');
      let caminho = /databases/$(database)/documents/$(colecao)/$(id)/historico/$(eid);
      return eid is string && eid.size() > 0 &&
        (resource == null || eid != resource.data.get('ultimoEventoId', '')) &&
        !exists(caminho) && existsAfter(caminho) && getAfter(caminho).data.autorId == eu();
    }

    // ── Unidades ───────────────────────────────────────────────
    // Os lugares de cada empresa (postos, lojas, escritório). O `codigo` é
    // aleatório e vai no QR da placa: ler o QR prova que o técnico esteve lá
    match /unidades/{unidadeId} {
      function unidadeValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['empresaId', 'nome', 'endereco', 'lat', 'lng', 'placaEm', 'ativa',
            'auditoriaId', 'criadoEm', 'atualizadoEm', 'isDemo']) &&
          d.nome is string && d.nome.size() > 0 && d.nome.size() <= 80 &&
          d.ativa is bool && (d.get('lat', null) == null || d.lat is number) &&
          (d.get('lng', null) == null || d.lng is number) &&
          (resource == null || d.empresaId == resource.data.empresaId);
      }
      function leUnidade(d) {
        let a = acesso();
        return estaLogado() && (((a.compras || a.serv != null || a.equip != null) && alcanca(a, d.empresaId)) ||
          (a.forn != '' && d.empresaId in a.empresas));
      }
      function gravaUnidade() {
        let a = acesso();
        return estaLogado() && (a.perfil in ['supremo', 'gestor'] || a.serv == 'gestor' || a.equip == 'gestor') &&
          alcanca(a, request.resource.data.empresaId) && !marcadoDemo(request.resource.data) &&
          unidadeValida() && auditada('unidade', unidadeId);
      }
      allow read: if leDemo() || leUnidade(resource.data);
      allow create, update: if gravaDemo(unidadeId) || gravaUnidade();
      allow delete: if leDemo() || (temPerfil() && eSupremo() && auditadaAoApagar('unidade', unidadeId));

      // O código da placa fica à parte: só quem cuida das unidades lê (para
      // imprimir a placa). A prestadora nunca lê o código; ela grava no
      // chamado só a prova (o hash do código com o ID do chamado), que as
      // regras conferem e que não serve para outro chamado
      match /privado/{docId} {
        function cuidaDaUnidade(empresaId) {
          let a = acesso();
          return estaLogado() && (a.perfil in ['supremo', 'gestor'] || a.serv == 'gestor' || a.equip == 'gestor') &&
            alcanca(a, empresaId);
        }
        function caminhoUn() { return /databases/$(database)/documents/unidades/$(unidadeId); }
        allow read: if (eDemo() && idDemo(unidadeId)) || (exists(caminhoUn()) && cuidaDaUnidade(get(caminhoUn()).data.empresaId));
        allow create, update: if (eDemo() && idDemo(unidadeId)) || (docId == 'placa' &&
          request.resource.data.keys().hasOnly(['codigo']) && request.resource.data.codigo is string &&
          request.resource.data.codigo.size() >= 12 && request.resource.data.codigo.size() <= 40 &&
          existsAfter(caminhoUn()) && cuidaDaUnidade(getAfter(caminhoUn()).data.empresaId));
        allow delete: if eDemo() && idDemo(unidadeId);
      }
    }

    // ── Contadores dos módulos (CH-0001; AC-0001 por prefixo) ──
    match /_meta/contadorChamados {
      allow read: if usaServicos();
      allow create, update: if usaServicos() &&
        request.resource.data.keys().hasOnly(['total']) &&
        request.resource.data.total == (resource == null ? 0 : resource.data.get('total', 0)) + 1;
    }
    // Um documento por prefixo da etiqueta (contadorEquip-AC, contadorEquip-PC…)
    match /_meta/{contador} {
      allow read: if contador.matches('contadorEquip-[A-Z]{2,3}') && usaEquip();
      allow create, update: if contador.matches('contadorEquip-[A-Z]{2,3}') && mexeEquip() &&
        request.resource.data.keys().hasOnly(['total']) &&
        request.resource.data.total == (resource == null ? 0 : resource.data.get('total', 0)) + 1;
    }

    // ── Chamados e visitas ─────────────────────────────────────
    // Quem vê: a gente da empresa com Serviços (qualquer papel) e a prestadora
    // do chamado. A consulta precisa filtrar pela empresa ou pela prestadora
    function veChamado(a, d) {
      return (a.serv != null && alcanca(a, d.empresaId)) || (a.forn != '' && d.fornecedorId == a.forn);
    }
    match /chamados/{chamadoId} {
      function chamadoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['numero', 'tipo', 'empresaId', 'unidadeId', 'unidadeNome', 'fornecedorId', 'fornecedorNome',
            'servicoId', 'titulo', 'descricao', 'urgente', 'equipamentoId', 'equipamentoRotulo', 'solicitanteId', 'solicitanteNome',
            'status', 'prazoEm', 'agendadoPara', 'tecnicoId', 'tecnicoNome', 'chegada', 'saida', 'relatorio', 'pecas',
            'confirmadoPor', 'confirmadoPorNome', 'confirmadoEm', 'contestacao', 'contestacoes', 'contestadoEm', 'cancelamento',
            'previstaPara', 'janelaAte', 'extrasAprovados', 'criadoEm', 'atualizadoEm', 'ultimoEventoId', 'isDemo']) &&
          d.tipo in ['chamado', 'visita'] &&
          d.status in ['prevista', 'aberto', 'agendado', 'atendimento', 'concluido', 'confirmado', 'contestado', 'nao_realizada', 'cancelado'] &&
          d.empresaId is string && d.fornecedorId is string && d.unidadeId is string &&
          d.get('titulo', '') is string && d.get('titulo', '').size() <= 120 &&
          d.get('descricao', '') is string && d.get('descricao', '').size() <= 4000 &&
          d.get('relatorio', '') is string && d.get('relatorio', '').size() <= 4000 &&
          (d.get('pecas', null) == null || (d.pecas is list && d.pecas.size() <= 30)) &&
          dataOk('previstaPara');
      }
      // O que nunca muda depois de aberto
      function mesmaOrigem() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['numero', 'tipo', 'empresaId', 'unidadeId',
          'fornecedorId', 'servicoId', 'solicitanteId', 'criadoEm', 'previstaPara', 'janelaAte', 'isDemo']);
      }
      function passo(de, para, campos) {
        return resource.data.status in de && request.resource.data.status == para &&
          mudouSo(campos.concat(['status', 'ultimoEventoId', 'atualizadoEm'])) &&
          request.resource.data.atualizadoEm == request.time && eventoNovo('chamados', chamadoId);
      }
      // A prova de presença: o QR da placa ou, sem a placa, o registro à mão
      // (fica marcado como tal para todos). Pelo QR, o app grava a prova: o
      // SHA-256 (hexadecimal) de "código|ID do chamado". O código em si nunca
      // é gravado no chamado (a prestadora leria e repetiria de longe)
      function presenca(m) {
        return m is map && m.keys().hasOnly(['em', 'via', 'prova', 'lat', 'lng', 'distanciaM', 'precisaoM']) &&
          m.em == request.time && m.via in ['qr', 'manual'] &&
          (m.via == 'manual' || m.get('prova', '') ==
            hashing.sha256(get(/databases/$(database)/documents/unidades/$(resource.data.unidadeId)/privado/placa).data.codigo + '|' + chamadoId).toHexString().lower());
      }
      function leChamado(d) { let a = acesso(); return estaLogado() && veChamado(a, d); }
      function criaChamado() {
        let a = acesso();
        let d = request.resource.data;
        return estaLogado() && !marcadoDemo(d) && chamadoValido() &&
          d.criadoEm == request.time && d.atualizadoEm == request.time &&
          exists(caminhoUnidade(d.unidadeId)) && get(caminhoUnidade(d.unidadeId)).data.empresaId == d.empresaId &&
          exists(caminhoFornecedor(d.fornecedorId)) && eventoNovo('chamados', chamadoId) && (
            // Chamado: aberto por quem tem Serviços na empresa, em nome próprio
            (d.tipo == 'chamado' && a.serv != null && alcanca(a, d.empresaId) &&
              d.status == 'aberto' && d.solicitanteId == eu() && d.numero is int && d.titulo.size() > 0) ||
            // Visita periódica: o ID fixo diz de quem, de qual serviço, onde e
            // quando; nasce prevista (janela aberta) ou não realizada (passou)
            (d.tipo == 'visita' && veChamado(a, d) &&
              chamadoId == 'vp-' + d.fornecedorId + '-' + d.servicoId + '-' + d.unidadeId + '-' + d.previstaPara &&
              d.janelaAte is timestamp &&
              ((d.status == 'prevista' && d.janelaAte > request.time) ||
               (d.status == 'nao_realizada' && d.janelaAte < request.time))));
      }
      function atualizaChamado() {
        let a = acesso();
        let d = request.resource.data;
        let r = resource.data;
        // O prestador do chamado; quem pediu (ou o gestor de Serviços); a gente da empresa
        let prest = a.forn != '' && r.fornecedorId == a.forn;
        let interno = a.serv != null && alcanca(a, r.empresaId);
        let pediu = interno && (r.solicitanteId == eu() || a.serv == 'gestor');
        return estaLogado() && !marcadoDemo(d) && chamadoValido() && mesmaOrigem() && (
          // O prestador agenda (ou reagenda): o técnico que vai
          (d.status == 'agendado' && prest && d.tecnicoId == eu() && d.agendadoPara is timestamp &&
            passo(['aberto', 'prevista', 'contestado', 'agendado'], 'agendado', ['agendadoPara', 'tecnicoId', 'tecnicoNome'])) ||
          // Chega ao local: o QR da unidade (ou à mão), com a hora do servidor
          (d.status == 'atendimento' && prest && d.tecnicoId == eu() && presenca(d.chegada) &&
            passo(['agendado', 'prevista', 'contestado', 'aberto'], 'atendimento', ['chegada', 'tecnicoId', 'tecnicoNome'])) ||
          // Conclui: o relatório e o QR de saída
          (d.status == 'concluido' && prest && r.tecnicoId == eu() && presenca(d.saida) && d.relatorio.size() > 0 &&
            passo(['atendimento'], 'concluido', ['saida', 'relatorio', 'pecas'])) ||
          // Quem pediu (ou o gestor de Serviços) confirma ou contesta
          (d.status == 'confirmado' && pediu && d.confirmadoPor == eu() && d.confirmadoEm == request.time &&
            passo(['concluido'], 'confirmado', ['confirmadoPor', 'confirmadoPorNome', 'confirmadoEm', 'extrasAprovados'])) ||
          (d.status == 'contestado' && pediu && d.contestadoEm == request.time && d.contestacao is map &&
            d.contestacao.get('motivo', '') is string && d.contestacao.get('motivo', '').size() > 0 &&
            d.contestacoes == r.get('contestacoes', 0) + 1 &&
            passo(['concluido'], 'contestado', ['contestacao', 'contestacoes', 'contestadoEm'])) ||
          // Cancelar o chamado ainda sem atendimento (a visita não se cancela)
          (d.status == 'cancelado' && pediu && r.tipo == 'chamado' && d.cancelamento is map &&
            d.cancelamento.get('motivo', '') is string && d.cancelamento.get('motivo', '').size() > 0 &&
            passo(['aberto', 'agendado'], 'cancelado', ['cancelamento'])) ||
          // A visita cuja janela passou sem chegada vira não realizada
          (d.status == 'nao_realizada' && (interno || prest) && r.tipo == 'visita' && request.time > r.janelaAte &&
            passo(['prevista', 'agendado'], 'nao_realizada', [])));
      }
      allow get, list: if leDemo() || leChamado(resource.data);
      allow create: if gravaDemo(chamadoId) || criaChamado();
      allow update: if gravaDemo(chamadoId) || atualizaChamado();
      allow delete: if leDemo();

      function caminhoCh() { return /databases/$(database)/documents/chamados/$(chamadoId); }
      // A demo decide só pelo ID, sem ler o chamado (como nos pedidos): a
      // renovação grava centenas de subdocumentos por lote, e cada leitura do pai
      // conta no limite de 20 acessos por lote das regras
      function areaDemoCh() { return eDemo() && idDemo(chamadoId); }
      function veOChamado() { return estaLogado() && exists(caminhoCh()) && veChamado(acesso(), get(caminhoCh()).data); }

      // Histórico: imutável, assinado por quem grava (nasce junto com a mudança)
      match /historico/{entradaId} {
        function entradaNova() {
          let d = request.resource.data;
          return estaLogado() && d.autorId == eu() && d.criadoEm == request.time && (
            veOChamado() ||
            // a entrada do chamado que nasce no mesmo lote
            (!exists(caminhoCh()) && existsAfter(caminhoCh()) && veChamado(acesso(), getAfter(caminhoCh()).data)));
        }
        allow read: if areaDemoCh() || veOChamado();
        allow create: if areaDemoCh() || entradaNova();
        allow update: if false;
        allow delete: if areaDemoCh();
      }
      // Conversa entre quem pediu, a equipe e a prestadora
      match /comentarios/{comentarioId} {
        function textoOk(d) { return d.texto is string && d.texto.size() > 0 && d.texto.size() <= 2000; }
        allow read: if areaDemoCh() || veOChamado();
        allow create: if areaDemoCh() || (veOChamado() && request.resource.data.autorId == eu() &&
          request.resource.data.keys().hasOnly(['texto', 'autorId', 'autorNome', 'criadoEm']) &&
          request.resource.data.criadoEm == request.time && textoOk(request.resource.data));
        allow update: if areaDemoCh() || (veOChamado() && resource.data.autorId == eu() &&
          mudouSo(['texto', 'editadoEm']) && request.resource.data.editadoEm == request.time && textoOk(request.resource.data));
        allow delete: if areaDemoCh() || (gestorServicos() && veOChamado());
      }
      // Fotos: prova do atendimento. A de abertura, de quem pediu; as de antes
      // e depois, do técnico em atendimento. Não se alteram nem se apagam
      match /fotos/{fotoId} {
        function fotoNova() {
          let a = acesso();
          let d = request.resource.data;
          let ch = get(caminhoCh()).data;
          return estaLogado() && exists(caminhoCh()) && veChamado(a, ch) &&
            d.keys().hasOnly(['tipo', 'storagePath', 'autorId', 'autorNome', 'criadoEm', 'tamanho', 'lat', 'lng']) &&
            d.autorId == eu() && d.criadoEm == request.time &&
            d.storagePath == 'chamados/' + chamadoId + '/fotos/' + fotoId + '.jpg' && (
              (d.tipo in ['antes', 'depois'] && a.forn != '' && ch.fornecedorId == a.forn && ch.status == 'atendimento') ||
              (d.tipo == 'abertura' && ch.solicitanteId == eu() && ch.status == 'aberto'));
        }
        allow read: if areaDemoCh() || veOChamado();
        allow create: if areaDemoCh() || fotoNova();
        allow update: if false;
        allow delete: if areaDemoCh();
      }
      // Serviço extra: o técnico pede (com o valor) durante o atendimento; o
      // gestor de Serviços aprova ou reprova antes de ser feito
      match /extras/{extraId} {
        function extraNovo() {
          let a = acesso();
          let d = request.resource.data;
          let ch = get(caminhoCh()).data;
          return estaLogado() && exists(caminhoCh()) && a.forn != '' && ch.fornecedorId == a.forn && ch.status == 'atendimento' &&
            d.keys().hasOnly(['descricao', 'valor', 'status', 'criadoPor', 'criadoPorNome', 'criadoEm']) &&
            d.criadoPor == eu() && d.criadoEm == request.time && d.status == 'aguardando' &&
            d.valor is number && d.valor > 0 && d.valor < 10000000 &&
            d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 200;
        }
        function decisao() {
          let a = acesso();
          let d = request.resource.data;
          return estaLogado() && exists(caminhoCh()) && a.serv == 'gestor' && alcanca(a, get(caminhoCh()).data.empresaId) &&
            resource.data.status == 'aguardando' && d.status in ['aprovado', 'reprovado'] &&
            mudouSo(['status', 'decididoPor', 'decididoPorNome', 'decididoEm', 'motivo']) &&
            d.decididoPor == eu() && d.decididoEm == request.time &&
            (d.status == 'aprovado' || d.get('motivo', '').size() > 0);
        }
        allow read: if areaDemoCh() || veOChamado();
        allow create: if areaDemoCh() || extraNovo();
        allow update: if areaDemoCh() || decisao();
        allow delete: if areaDemoCh();
      }
    }

    // ── Equipamentos ───────────────────────────────────────────
    function veEquip(a, d) { return (a.equip != null || a.serv != null) && alcanca(a, d.empresaId); }
    match /equipamentos/{equipId} {
      function eqValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['etiqueta', 'tipo', 'descricao', 'marca', 'modelo', 'serie', 'empresaId', 'unidadeId',
            'unidadeNome', 'setor', 'status', 'aquisicao', 'garantiaAte', 'precoNovo', 'custos', 'conserto', 'baixa',
            'notas', 'criadoEm', 'atualizadoEm', 'ultimoEventoId', 'isDemo']) &&
          d.etiqueta is string && d.etiqueta.matches('^[A-Z]{2,3}-[0-9]{4,6}$') &&
          d.tipo in ['ar_condicionado', 'computador', 'notebook', 'monitor', 'impressora', 'camera', 'rede', 'nobreak',
            'celular', 'tv', 'bomba', 'outro'] &&
          d.status in ['uso', 'conserto', 'reserva', 'baixado'] &&
          d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 120 &&
          d.empresaId is string && d.unidadeId is string &&
          (d.get('custos', null) == null || (d.custos is list && d.custos.size() <= 200)) &&
          (d.get('precoNovo', null) == null || (d.precoNovo is number && d.precoNovo >= 0)) &&
          dataOk('garantiaAte') &&
          exists(caminhoUnidade(d.unidadeId)) && get(caminhoUnidade(d.unidadeId)).data.empresaId == d.empresaId;
      }
      function leEquip(d) { let a = acesso(); return estaLogado() && veEquip(a, d); }
      function criaEquip() {
        let a = acesso();
        let d = request.resource.data;
        let partes = d.etiqueta.split('-');
        let contador = /databases/$(database)/documents/_meta/$('contadorEquip-' + partes[0]);
        return estaLogado() && a.equip in ['responsavel', 'gestor'] && alcanca(a, d.empresaId) &&
          !marcadoDemo(d) && eqValido() && d.criadoEm == request.time && d.status in ['uso', 'reserva'] &&
          eventoNovo('equipamentos', equipId) &&
          // A etiqueta é a do contador do prefixo, que sobe 1 no mesmo lote
          existsAfter(contador) && getAfter(contador).data.total == int(partes[1]);
      }
      function atualizaEquip() {
        let a = acesso();
        let d = request.resource.data;
        let r = resource.data;
        let n = d.get('custos', []).size();
        let ch = /databases/$(database)/documents/chamados/$(n > 0 ? d.custos[n - 1].get('chamadoId', '-') : '-');
        return estaLogado() && !marcadoDemo(d) && eqValido() &&
          d.etiqueta == r.etiqueta && d.tipo == r.tipo && d.get('isDemo', false) == r.get('isDemo', false) &&
          d.atualizadoEm == request.time && eventoNovo('equipamentos', equipId) && (
            (a.equip == 'gestor' && alcanca(a, r.empresaId) && alcanca(a, d.empresaId)) ||
            // O responsável não muda a empresa, o preço de referência nem dá baixa
            (a.equip == 'responsavel' && alcanca(a, r.empresaId) && d.empresaId == r.empresaId &&
              d.get('precoNovo', null) == r.get('precoNovo', null) && d.status != 'baixado' && r.status != 'baixado') ||
            // O custo de um chamado de Serviços confirmado entra pelo próprio
            // Serviços: só uma linha nova, apontando para um chamado confirmado
            // deste aparelho
            (a.serv != null && alcanca(a, r.empresaId) && mudouSo(['custos', 'ultimoEventoId', 'atualizadoEm']) &&
              n == r.get('custos', []).size() + 1 && d.custos.hasAll(r.get('custos', [])) &&
              existsAfter(ch) && getAfter(ch).data.get('equipamentoId', '') == equipId &&
              getAfter(ch).data.status == 'confirmado'));
      }
      allow read: if leDemo() || leEquip(resource.data);
      allow create: if gravaDemo(equipId) || criaEquip();
      allow update: if gravaDemo(equipId) || atualizaEquip();
      allow delete: if leDemo() || (temPerfil() && eSupremo());

      function caminhoEq() { return /databases/$(database)/documents/equipamentos/$(equipId); }
      function areaDemoEq() { return eDemo() && idDemo(equipId); }
      function veOEquip() { return estaLogado() && exists(caminhoEq()) && veEquip(acesso(), get(caminhoEq()).data); }
      match /historico/{entradaId} {
        function entradaNova() {
          let d = request.resource.data;
          let a = acesso();
          return estaLogado() && d.autorId == eu() && d.criadoEm == request.time && (
            (exists(caminhoEq()) && veEquip(a, get(caminhoEq()).data)) ||
            (!exists(caminhoEq()) && existsAfter(caminhoEq()) && a.equip in ['responsavel', 'gestor'] &&
              alcanca(a, getAfter(caminhoEq()).data.empresaId)));
        }
        allow read: if areaDemoEq() || veOEquip();
        allow create: if areaDemoEq() || entradaNova();
        allow update: if false;
        allow delete: if areaDemoEq();
      }
    }

    // ── Contagens (inventário de uma unidade) ──────────────────
    match /contagens/{contagemId} {
      function contagemNova() {
        let a = acesso();
        let d = request.resource.data;
        return estaLogado() && a.equip in ['responsavel', 'gestor'] && alcanca(a, d.empresaId) && !marcadoDemo(d) &&
          d.keys().hasOnly(['empresaId', 'unidadeId', 'unidadeNome', 'porId', 'porNome', 'em',
            'encontrados', 'faltando', 'foraDoLugar', 'total']) &&
          d.porId == eu() && d.em == request.time &&
          d.encontrados is list && d.faltando is list && d.foraDoLugar is list && d.encontrados.size() <= 2000;
      }
      allow read: if leDemo() || (estaLogado() && acesso().equip != null && alcanca(acesso(), resource.data.empresaId));
      allow create: if gravaDemo(contagemId) || contagemNova();
      // Uma contagem não muda depois de gravada; só a de exemplo da demo é
      // regravada a cada renovação
      allow update: if gravaDemo(contagemId);
      allow delete: if leDemo();
    }

    // ── Notificações ───────────────────────────────────────────
    // A conta demo também lê as notificações das pessoas da demonstração
    // (IDs "demo-…", js/demo-pessoas.js), que ela representa dentro do app
    function eDonoNotificacao(userId) {
      return request.auth.uid == userId || (eDemo() && idDemo(userId));
    }

    match /notificacoes/{userId}/items/{notifId} {
      allow read:   if estaLogado() && eDonoNotificacao(userId);
      allow update: if estaLogado() && eDonoNotificacao(userId) && mudouSo(['lida']);
      allow delete: if estaLogado() && eDonoNotificacao(userId);
      // Os avisos automáticos vêm das Cloud Functions (que não passam pelas
      // regras). Pelo app, só o aviso de menção num comentário, assinado por
      // quem mencionou; na demo, a conta demo grava os das pessoas dela
      allow create: if estaLogado() && (
        eDonoNotificacao(userId) || (
          temPerfil() &&
          request.resource.data.evento == 'mencao_comentario' &&
          request.resource.data.autorId == request.auth.uid &&
          request.resource.data.lida == false &&
          request.resource.data.keys().hasOnly(['evento', 'titulo', 'corpo', 'pedidoId', 'lida', 'criadaEm', 'autorId'])
        )
      );
    }
  }
}
