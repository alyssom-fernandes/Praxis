rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ─────────────────────────────────────
    function estaLogado() {
      return request.auth != null;
    }

    // Conta da demonstração pública. A senha dela vai no js/config.js do
    // site, então qualquer pessoa pode usá-la fora da interface. Por isso ela
    // tem um perfil próprio, 'demo', que não vale como nenhum outro: só lê e
    // grava o que é da demonstração (documentos com isDemo == true, pedidos
    // com ID "demo-…" e os avisos das pessoas da demo). Os IDs automáticos do
    // Firestore não têm hífen, então nenhum pedido real cai nessa área.
    // As permissões gravadas no token (custom claims) não valem para ela.
    function eDemo() {
      return estaLogado() && request.auth.token.get('email', '') == 'demo@praxis.app';
    }

    // Perfil e empresas de quem está logado. Com a Cloud Function setUserClaims
    // (plano Blaze), vêm do token (custom claims). Sem ela, no plano gratuito,
    // vêm do documento da própria pessoa em /usuarios, que só um gestor ou o
    // supremo altera (regras de /usuarios abaixo). Usuário inativo fica sem perfil.
    function temClaims() {
      return request.auth.token.get('perfil', null) != null;
    }
    function caminhoMeuUsuario() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function meuDocumento() {
      return exists(caminhoMeuUsuario()) ? get(caminhoMeuUsuario()).data : {};
    }
    function perfilDoDocumento() {
      return meuDocumento().get('ativo', true) == false ? null : meuDocumento().get('perfil', null);
    }
    function perfil() {
      return eDemo() ? 'demo' : (temClaims() ? request.auth.token.perfil : perfilDoDocumento());
    }

    function idDemo(id) { return id.matches('demo-.*'); }
    function marcadoDemo(dados) { return dados.get('isDemo', false) == true; }

    // A conta demo lê só o que está marcado como demo (a consulta precisa
    // filtrar por isDemo == true) e grava só documentos que continuam
    // marcados. Um documento que já existe só é regravado se já era da demo.
    function leDemo() { return eDemo() && marcadoDemo(resource.data); }
    function gravaDemo(id) {
      return eDemo() && marcadoDemo(request.resource.data) &&
        (resource == null || marcadoDemo(resource.data) || idDemo(id));
    }

    // Conta sem perfil (criada fora do app) não lê nem grava nada
    function temPerfil() {
      return estaLogado() &&
        perfil() in ['supremo', 'gestor', 'aprovador', 'comprador', 'financeiro', 'solicitante'];
    }

    function empresasDoUsuario() {
      return temClaims() ? request.auth.token.get('empresas', []) : meuDocumento().get('empresas', []);
    }

    function temAcessoEmpresa(empresaId) {
      return empresaId in empresasDoUsuario();
    }

    function eSupremo() { return perfil() == 'supremo'; }
    function eGestor()  { return perfil() in ['supremo', 'gestor']; }
    function eAprovador() { return perfil() in ['supremo', 'gestor', 'aprovador']; }
    function eComprador() { return perfil() in ['supremo', 'gestor', 'comprador']; }
    function eFinanceiro() { return perfil() in ['supremo', 'gestor', 'financeiro']; }

    // O supremo alcança todas as empresas; os outros, as do próprio perfil
    function alcancaEmpresa(empresaId) {
      return eSupremo() || temAcessoEmpresa(empresaId);
    }

    function eu() { return request.auth.uid; }
    function mudouSo(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Datas no formato aaaa-mm-dd (ou vazias): vale para todos, demo inclusive,
    // porque o app as mostra na tela
    function dataOk(campo) {
      return request.resource.data.get(campo, null) == null ||
        request.resource.data.get(campo, null).matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function pedidoValido() {
      return request.resource.data.status in
          ['solicitado', 'ag_cotacao', 'em_aprovacao', 'aprovado', 'comprado', 'entregue', 'pago', 'reprovado', 'cancelado'] &&
        dataOk('dataNecessaria') && dataOk('dataCompra') && dataOk('dataEntrega');
    }

    // ── Usuários ───────────────────────────────────────────────
    match /usuarios/{userId} {
      // Quem não é supremo não cria, edita nem promove ninguém a supremo, e só
      // dá acesso às empresas que ele mesmo tem
      function semPromover() {
        return eSupremo() || (
          request.resource.data.get('perfil', '') != 'supremo' &&
          (resource == null || resource.data.get('perfil', '') != 'supremo') &&
          request.resource.data.get('empresas', []).hasOnly(empresasDoUsuario())
        );
      }

      // O gestor só alcança quem é das empresas dele: lê quem tem ao menos
      // uma em comum e só edita quem está inteiro dentro delas (assim ele não
      // puxa para a sua empresa, nem muda o perfil de, alguém de outra)
      function mesmaEmpresa() {
        return resource.data.get('empresas', []).hasAny(empresasDoUsuario());
      }
      function todoNasMinhasEmpresas() {
        return mesmaEmpresa() && resource.data.get('empresas', []).hasOnly(empresasDoUsuario());
      }

      // A conta demo: as pessoas da demonstração (IDs "demo-…", marcadas), o
      // próprio perfil (perfil 'demo', que não dá permissão nenhuma) e os
      // perfis antigos dela mesma (de quando a conta foi recriada no console)
      function perfilDaContaDemo(dados) {
        return dados.get('email', '') == 'demo@praxis.app';
      }
      function demoGravaUsuario() {
        return eDemo() && (
          (idDemo(userId) && marcadoDemo(request.resource.data) &&
            (resource == null || marcadoDemo(resource.data))) ||
          (request.auth.uid == userId && resource == null &&
            perfilDaContaDemo(request.resource.data) &&
            request.resource.data.get('perfil', '') == 'demo') ||
          (request.auth.uid == userId && resource != null &&
            mudouSo(['empresas', 'atualizadoEm', 'ultimoAcesso']))
        );
      }

      // Primeiro acesso de quem foi convidado: a própria pessoa cria o seu
      // perfil copiando o convite (/convites/{e-mail}) campo a campo, enquanto
      // ele vale. O app apaga o convite no mesmo lote.
      function caminhoConvite() {
        return /databases/$(database)/documents/convites/$(request.auth.token.get('email', '').lower());
      }
      function aceitaConvite() {
        return request.auth.uid == userId && !eDemo() &&
          request.auth.token.get('email', '') != '' &&
          exists(caminhoConvite()) &&
          get(caminhoConvite()).data.expiraEm > request.time &&
          request.resource.data.keys().hasOnly(
            ['nome', 'email', 'perfil', 'empresas', 'ativo', 'convidadoPor', 'criadoEm', 'ultimoAcesso']) &&
          request.resource.data.get('nome', '') == get(caminhoConvite()).data.nome &&
          request.resource.data.get('email', '') == get(caminhoConvite()).data.email &&
          request.resource.data.get('perfil', '') == get(caminhoConvite()).data.perfil &&
          request.resource.data.get('empresas', []) == get(caminhoConvite()).data.empresas &&
          request.resource.data.get('ativo', false) == get(caminhoConvite()).data.ativo &&
          request.resource.data.get('convidadoPor', '') == get(caminhoConvite()).data.criadoPor;
      }

      allow read: if estaLogado() && (
        request.auth.uid == userId || eSupremo() ||
        (temPerfil() && eGestor() && mesmaEmpresa()) ||
        (eDemo() && (marcadoDemo(resource.data) || perfilDaContaDemo(resource.data)))
      );
      allow create: if (temPerfil() && eGestor() && semPromover()) || demoGravaUsuario() || aceitaConvite();
      // O próprio usuário só registra o último acesso: perfil e empresas valem
      // como permissão (no token, pela setUserClaims, ou lidos daqui pelas
      // regras) e não podem ser mudados por ele
      allow update: if estaLogado() && (
        (request.auth.uid == userId && !eDemo() && mudouSo(['ultimoAcesso'])) ||
        (temPerfil() && eGestor() && request.auth.uid != userId &&
          (eSupremo() || todoNasMinhasEmpresas()) && semPromover()) ||
        eSupremo() || demoGravaUsuario()
      );
      allow delete: if estaLogado() && (
        eSupremo() ||
        (eDemo() && request.auth.uid != userId && perfilDaContaDemo(resource.data))
      );
    }

    // ── Convites ───────────────────────────────────────────────
    // Quem administra convida pelo e-mail (o ID é o e-mail em minúsculas), com
    // perfil, empresas e prazo de até 60 dias. No primeiro acesso, a pessoa cria
    // o próprio perfil a partir do convite (aceitaConvite, em /usuarios) e o
    // apaga. Confiar no e-mail do token depende da criação de contas desligada
    // no Firebase Auth: só quem administra cria a conta de login.
    match /convites/{email} {
      function meuEmail() { return request.auth.token.get('email', '').lower(); }
      function conviteValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(
            ['email', 'nome', 'perfil', 'empresas', 'ativo', 'criadoPor', 'criadoPorNome', 'criadoEm', 'expiraEm']) &&
          d.email == email && email == email.lower() && email.matches('^[^@/ ]+@[^@/ ]+$') &&
          d.nome is string && d.nome.size() > 0 && d.nome.size() <= 80 &&
          d.perfil in ['supremo', 'gestor', 'aprovador', 'comprador', 'financeiro', 'solicitante'] &&
          d.empresas is list && d.ativo == true &&
          d.criadoPor == request.auth.uid &&
          d.expiraEm is timestamp && d.expiraEm > request.time &&
          d.expiraEm < request.time + duration.value(61, 'd') &&
          (eSupremo() || (d.perfil != 'supremo' && d.empresas.size() > 0 &&
            d.empresas.hasOnly(empresasDoUsuario())));
      }
      // O gestor alcança os convites inteiros dentro das empresas dele (como
      // nos usuários); o supremo, todos
      function conviteDoGestor() {
        return eSupremo() || (eGestor() &&
          resource.data.get('perfil', '') != 'supremo' &&
          resource.data.get('empresas', []).hasOnly(empresasDoUsuario()));
      }

      allow read: if estaLogado() && (
        meuEmail() == email ||
        (temPerfil() && (eSupremo() || (eGestor() &&
          resource.data.get('empresas', []).hasAny(empresasDoUsuario()))))
      );
      allow create: if temPerfil() && eGestor() && conviteValido();
      allow update: if temPerfil() && eGestor() && conviteDoGestor() && conviteValido();
      allow delete: if estaLogado() && (
        (temPerfil() && conviteDoGestor()) ||
        (meuEmail() == email && existsAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)))
      );
    }

    // ── Empresas ───────────────────────────────────────────────
    // O gestor só edita as empresas a que tem acesso
    match /empresas/{empresaId} {
      allow read:   if temPerfil() || leDemo();
      allow create: if (temPerfil() && eGestor()) || gravaDemo(empresaId);
      allow update: if (temPerfil() && (eSupremo() || (eGestor() && temAcessoEmpresa(empresaId)))) ||
        gravaDemo(empresaId);
      allow delete: if temPerfil() && eSupremo();
    }

    // ── Categorias ─────────────────────────────────────────────
    match /categorias/{catId} {
      allow read:   if temPerfil() || leDemo();
      allow create: if (temPerfil() && eGestor()) || gravaDemo(catId);
      allow update: if (temPerfil() && eGestor()) || gravaDemo(catId);
      allow delete: if temPerfil() && eSupremo();
    }

    // ── Fornecedores ───────────────────────────────────────────
    match /fornecedores/{fornId} {
      allow read:   if temPerfil() || leDemo();
      allow create: if (temPerfil() && eComprador()) || gravaDemo(fornId);
      allow update: if (temPerfil() && (eComprador() || eGestor())) || gravaDemo(fornId);
      allow delete: if (temPerfil() && eGestor()) || leDemo();
    }

    // ── Metadados internos ─────────────────────────────────────
    // Contador do número do pedido (PRX-0001…): quem abre um pedido soma 1
    match /_meta/contadores {
      allow read: if temPerfil();
      allow create, update: if temPerfil() && (eSupremo() || (
        request.resource.data.keys().hasOnly(['totalPedidos']) &&
        request.resource.data.totalPedidos ==
          (resource == null ? 0 : resource.data.get('totalPedidos', 0)) + 1
      ));
    }
    // Contador próprio da demo: a conta demo não mexe na numeração real
    match /_meta/contadoresDemo {
      allow read, write: if eDemo();
    }
    // Trava e dia da renovação da demo: só a conta demo
    match /_meta/demo {
      allow read, write: if eDemo();
    }

    // ── Pedidos ────────────────────────────────────────────────
    match /pedidos/{pedidoId} {
      // Cada passo do caminho, com quem pode dá-lo e o que pode mudar
      // (o mesmo que o app mostra em js/pedido-detalhe.js e js/pedidos.js).
      // Vale para todos os perfis, o supremo inclusive: ele age como um gestor
      // de todas as empresas, sem pular etapas
      function de(st0, st1) {
        return resource.data.status == st0 && request.resource.data.status == st1;
      }
      function oComprador() {
        return resource.data.get('compradorId', null) == eu() || eGestor();
      }
      function oSolicitante() { return resource.data.get('solicitanteId', null) == eu(); }
      // Separação de funções: quem abriu ou cotou o pedido não decide sobre
      // ele, e quem o aprovou não registra a compra nem o pagamento
      function cotou()   { return resource.data.get('compradorId', null) == eu(); }
      function aprovou() { return resource.data.get('aprovadoPor', null) == eu(); }

      // Reprovar e cancelar exigem o motivo da lista e, em "Outros", o texto
      function motivoDado(campo, campoOutros) {
        let motivo = request.resource.data.get(campo, null);
        let outros = request.resource.data.get(campoOutros, null);
        return motivo is string && motivo.trim().size() > 0 &&
          (motivo != 'Outros' || (outros is string && outros.trim().size() > 0));
      }

      // Para ir a "Em aprovação", o pedido aponta a cotação indicada
      // (cotacaoIndicadaId): ela já existia e sai do lote marcada como indicada
      function caminhoCotacao(id) {
        return /databases/$(database)/documents/pedidos/$(pedidoId)/cotacoes/$(id);
      }
      function cotacaoIndicadaValida() {
        let id = request.resource.data.get('cotacaoIndicadaId', null);
        return id is string && id.size() > 0 && exists(caminhoCotacao(id)) &&
          getAfter(caminhoCotacao(id)).data.get('indicada', false) == true;
      }

      // O pedido reaberto traz a justificativa de quem o reabriu
      function reaberturaJustificada() {
        let justificativa = request.resource.data.get('justificativaReabertura', null);
        return request.resource.data.get('reabertoDe', null) == null ||
          (justificativa is string && justificativa.trim().size() > 0);
      }

      // Entrada do histórico gravada no mesmo lote (ou transação) que a
      // mudança: não existia antes e passa a existir, do tipo certo e assinada
      // por quem grava. A edição do pedido e o comprovante da parcela apontam
      // para ela (ultimaEdicaoId, comprovanteEventoId); a cotação e o anexo
      // usam o próprio ID na entrada. Sem ela, a gravação é recusada.
      function caminhoHistorico(id) {
        return /databases/$(database)/documents/pedidos/$(pedidoId)/historico/$(id);
      }
      function registraNoHistorico(id, tipo) {
        return id is string && id.size() > 0 &&
          !exists(caminhoHistorico(id)) && existsAfter(caminhoHistorico(id)) &&
          getAfter(caminhoHistorico(id)).data.get('tipo', '') == tipo &&
          getAfter(caminhoHistorico(id)).data.get('autorId', '') == eu();
      }

      // Marca de "visto" de quem abriu o pedido e data do último comentário
      function visto() {
        return mudouSo(['vistoPor']) &&
          request.resource.data.get('vistoPor', {}).diff(resource.data.get('vistoPor', {}))
            .affectedKeys().hasOnly([eu()]);
      }
      function comentou() { return mudouSo(['ultimoComentarioEm']); }

      function assumir() {
        return de('solicitado', 'ag_cotacao') && eComprador() &&
          resource.data.get('compradorId', null) == null &&
          request.resource.data.compradorId == eu() &&
          mudouSo(['status', 'compradorId', 'compradorNome', 'compradorAssumiuEm', 'atualizadoEm']);
      }
      function liberar() {
        return de('ag_cotacao', 'solicitado') && eGestor() &&
          request.resource.data.compradorId == null &&
          mudouSo(['status', 'compradorId', 'compradorNome', 'compradorAssumiuEm', 'atualizadoEm']);
      }
      function indicarCotacao() {
        return de('ag_cotacao', 'em_aprovacao') && eComprador() && oComprador() &&
          cotacaoIndicadaValida() &&
          mudouSo(['status', 'cotacaoIndicadaId', 'atualizadoEm']);
      }
      // Quem abriu ou cotou o pedido não decide sobre ele
      function aprovar() {
        return de('em_aprovacao', 'aprovado') && eAprovador() && !oSolicitante() && !cotou() &&
          request.resource.data.aprovadoPor == eu() &&
          mudouSo(['status', 'aprovadoPor', 'aprovadoPorNome', 'aprovadoEm', 'atualizadoEm']);
      }
      function reprovar() {
        return de('em_aprovacao', 'reprovado') && eAprovador() && !oSolicitante() && !cotou() &&
          request.resource.data.reprovadoPor == eu() &&
          motivoDado('motivoReprovacao', 'motivoReprovacaoOutros') &&
          mudouSo(['status', 'reprovadoPor', 'reprovadoPorNome', 'reprovadoEm',
                   'motivoReprovacao', 'motivoReprovacaoOutros', 'atualizadoEm']);
      }
      // Quem aprovou não registra a compra nem o pagamento
      function comprar() {
        return de('aprovado', 'comprado') && eComprador() && oComprador() && !aprovou() &&
          mudouSo(['status', 'fornecedorId', 'fornecedorNome', 'valorFinal',
                   'condicaoPagamento', 'dataCompra', 'atualizadoEm']);
      }
      // Recebe o comprador responsável (ou um gestor) ou quem pediu
      function receber() {
        return de('comprado', 'entregue') && ((eComprador() && oComprador()) || oSolicitante()) &&
          mudouSo(['status', 'dataEntrega', 'atualizadoEm']);
      }
      function pagar() {
        return de('entregue', 'pago') && eFinanceiro() && !aprovou() &&
          mudouSo(['status', 'atualizadoEm']);
      }
      function cancelar() {
        return request.resource.data.status == 'cancelado' && (
          (oSolicitante() && resource.data.status == 'solicitado') ||
          (eGestor() && !(resource.data.status in ['entregue', 'pago', 'reprovado', 'cancelado']))
        ) &&
          motivoDado('motivoCancelamento', 'motivoCancelamentoOutros') &&
          mudouSo(['status', 'canceladoPor', 'canceladoPorNome', 'canceladoEm',
                   'motivoCancelamento', 'motivoCancelamentoOutros', 'atualizadoEm']);
      }
      function editar() {
        return (
          (oSolicitante() && resource.data.status == 'solicitado') ||
          (eGestor() && !(resource.data.status in ['pago', 'reprovado', 'cancelado']))
        ) &&
          mudouSo(['titulo', 'descricao', 'valorEstimado', 'dataNecessaria',
                   'categoriaId', 'urgente', 'atualizadoEm', 'ultimaEdicaoId']) &&
          registraNoHistorico(request.resource.data.get('ultimaEdicaoId', ''), 'edicao');
      }
      function reabrir() {
        return resource.data.status == 'reprovado' &&
          resource.data.get('reabertoPara', null) == null &&
          (eGestor() || (perfil() == 'solicitante' && oSolicitante())) &&
          mudouSo(['reabertoPara', 'reabertaParaNum', 'atualizadoEm']);
      }

      // A marca isDemo nasce com o pedido e não muda: um pedido real nunca
      // vira demo (e a conta demo só apaga pedidos da demo)
      function mesmaMarcaDemo() {
        return marcadoDemo(request.resource.data) == marcadoDemo(resource.data);
      }

      allow get: if leDemo() || (temPerfil() && (
        eSupremo() || temAcessoEmpresa(resource.data.empresaId) ||
        resource.data.solicitanteId == eu()
      ));
      // A consulta precisa filtrar pelas empresas do usuário (ou, para o
      // solicitante, pelos pedidos dele); sem filtro, só o supremo lista.
      // A conta demo filtra por isDemo == true.
      allow list: if leDemo() || (temPerfil() && (
        eSupremo() || resource.data.empresaId in empresasDoUsuario() ||
        resource.data.solicitanteId == eu()
      ));
      // Todo pedido nasce em "Solicitado", aberto em nome próprio (o gestor e o
      // supremo também abrem em nome de outra pessoa)
      allow create: if pedidoValido() && (
        (eDemo() && idDemo(pedidoId) && marcadoDemo(request.resource.data)) ||
        (temPerfil() && !idDemo(pedidoId) && !marcadoDemo(request.resource.data) &&
          alcancaEmpresa(request.resource.data.empresaId) &&
          request.resource.data.status == 'solicitado' &&
          (request.resource.data.solicitanteId == eu() || eGestor()) &&
          reaberturaJustificada())
      );
      allow update: if pedidoValido() && mesmaMarcaDemo() && (
        leDemo() || (temPerfil() &&
          alcancaEmpresa(resource.data.empresaId) &&
          request.resource.data.empresaId == resource.data.empresaId && (
            visto() || comentou() || assumir() || liberar() || indicarCotacao() ||
            aprovar() || reprovar() || comprar() || receber() || pagar() ||
            cancelar() || editar() || reabrir()
          ))
      );
      // Pedidos nunca são deletados (apenas cancelados), exceto os da demo na renovação
      allow delete: if leDemo();

      // Subcoleções: a área da demo vem primeiro e é decidida pelo ID do
      // pedido, sem ler o pedido-pai (a renovação grava em lote, e num lote as
      // regras podem ler no máximo 20 documentos)
      function areaDemo() { return eDemo() && idDemo(pedidoId); }
      function pai() {
        return get(/databases/$(database)/documents/pedidos/$(pedidoId)).data;
      }
      function veOPedido() {
        return eSupremo() || temAcessoEmpresa(pai().empresaId) || pai().solicitanteId == eu();
      }
      // A empresa do pedido é da pessoa (o supremo alcança todas)
      function daEmpresa() {
        return eSupremo() || temAcessoEmpresa(pai().empresaId);
      }
      // Quem grava assina com o próprio UID, o supremo também
      function autorSouEu() {
        return request.resource.data.autorId == eu();
      }
      // O comprador que assumiu o pedido (ou um gestor da empresa)
      function compradorDoPedido() {
        return pai().get('compradorId', null) == eu() || eGestor();
      }

      // ── Cotações ─────────────────────────────────────────────
      // Só o comprador que assumiu o pedido (ou um gestor da empresa) registra e
      // indica, e só enquanto o pedido está em cotação: depois, as propostas que
      // foram para a aprovação não mudam. A cotação nova vem com a entrada do
      // histórico de mesmo ID, no mesmo lote; a indicação muda só a marca
      match /cotacoes/{cotacaoId} {
        function emCotacao() { return pai().status == 'ag_cotacao'; }
        function cotaOPedido() {
          return eComprador() && daEmpresa() && compradorDoPedido() && emCotacao();
        }
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && cotaOPedido() &&
          registraNoHistorico(cotacaoId, 'cotacao'));
        allow update: if areaDemo() || (temPerfil() && cotaOPedido() && mudouSo(['indicada']));
        allow delete: if areaDemo() || (temPerfil() && eGestor() && daEmpresa() && emCotacao());
      }

      // ── Comentários ───────────────────────────────────────────
      // Editar muda só o texto; editar e apagar valem só dentro de um pedido
      // que a pessoa vê (o gestor, só nas empresas dele)
      match /comentarios/{comentarioId} {
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && veOPedido() && autorSouEu());
        allow update: if areaDemo() || (temPerfil() && veOPedido() &&
          mudouSo(['texto', 'editadoEm']) && (
            request.auth.uid == resource.data.autorId || (eGestor() && daEmpresa())
          ));
        allow delete: if areaDemo() || (temPerfil() && eGestor() && daEmpresa());
      }

      // ── Parcelas ──────────────────────────────────────────────
      // O financeiro registra o pagamento (pago, pagoEm) e anexa o comprovante,
      // menos quem aprovou o pedido; o comprovante vem com a entrada do
      // histórico, no mesmo lote
      match /parcelas/{parcelaId} {
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && eComprador() && daEmpresa());
        allow update: if areaDemo() || (temPerfil() &&
          eFinanceiro() && daEmpresa() && pai().get('aprovadoPor', null) != eu() && (
            mudouSo(['pago', 'pagoEm']) ||
            (mudouSo(['comprovante', 'comprovanteEventoId']) &&
              registraNoHistorico(request.resource.data.get('comprovanteEventoId', ''), 'comprovante'))
          ));
        allow delete: if areaDemo(); // só a renovação da demo
      }

      // ── Histórico ─────────────────────────────────────────────
      match /historico/{entradaId} {
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && veOPedido() && autorSouEu());
        allow update: if false; // Histórico é imutável
        allow delete: if areaDemo(); // só a renovação da demo
      }

      // ── Anexos gerais ─────────────────────────────────────────
      // O anexo novo vem com a entrada do histórico de mesmo ID, no mesmo lote;
      // apaga quem anexou ou um gestor da empresa do pedido
      match /anexos/{anexoId} {
        allow read: if areaDemo() || (temPerfil() && veOPedido());
        allow create: if areaDemo() || (temPerfil() && veOPedido() && autorSouEu() &&
          registraNoHistorico(anexoId, 'anexo'));
        // Apaga um gestor da empresa (o supremo, de qualquer uma) ou quem
        // anexou, enquanto ainda vê o pedido
        allow delete: if areaDemo() || (temPerfil() && (
          (eGestor() && daEmpresa()) ||
          (request.auth.uid == resource.data.autorId && veOPedido())
        ));
        allow update: if false;
      }
    }

    // ── Notificações ───────────────────────────────────────────
    // A conta demo também lê as notificações das pessoas da demonstração
    // (IDs "demo-…", js/demo-pessoas.js), que ela representa dentro do app
    function eDonoNotificacao(userId) {
      return request.auth.uid == userId || (eDemo() && idDemo(userId));
    }

    match /notificacoes/{userId}/items/{notifId} {
      allow read:   if estaLogado() && eDonoNotificacao(userId);
      allow update: if estaLogado() && eDonoNotificacao(userId) && mudouSo(['lida']);
      allow delete: if estaLogado() && eDonoNotificacao(userId);
      // Os avisos automáticos vêm das Cloud Functions (que não passam pelas
      // regras). Pelo app, só o aviso de menção num comentário, assinado por
      // quem mencionou; na demo, a conta demo grava os das pessoas dela
      allow create: if estaLogado() && (
        eDonoNotificacao(userId) || (
          temPerfil() &&
          request.resource.data.evento == 'mencao_comentario' &&
          request.resource.data.autorId == request.auth.uid &&
          request.resource.data.lida == false &&
          request.resource.data.keys().hasOnly(['evento', 'titulo', 'corpo', 'pedidoId', 'lida', 'criadaEm', 'autorId'])
        )
      );
    }
  }
}
