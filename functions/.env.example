# Variáveis das Cloud Functions. Copie para functions/.env (que não é versionado).
# Sem RESEND_API_KEY os e-mails ficam desligados e o resto funciona normalmente.

# Endereço do app, usado nos links dos e-mails
APP_URL=https://praxis-af618.web.app

# Remetente dos e-mails (precisa ser de um domínio verificado no Resend)
FROM_EMAIL=Praxis <nao-responda@seu-dominio.com.br>

# Chave da API do Resend
RESEND_API_KEY=
