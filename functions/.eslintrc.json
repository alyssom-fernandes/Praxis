{
  "root": true,
  "env": { "es2022": true, "node": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "script" },
  "extends": ["eslint:recommended"],
  "ignorePatterns": ["node_modules/"],
  "rules": {
    "no-unused-vars": ["error", { "args": "none", "ignoreRestSiblings": true }]
  }
}
