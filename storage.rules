rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Cotações — leitura por todos com acesso, escrita apenas compradores
    match /pedidos/{pedidoId}/cotacoes/{cotacaoId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.perfil in ['supremo', 'gestor', 'comprador']
        && request.resource.size < 10 * 1024 * 1024  // 10 MB
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // Comprovantes — leitura por todos, escrita apenas financeiro/gestor
    match /pedidos/{pedidoId}/comprovantes/{parcelaId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.perfil in ['supremo', 'gestor', 'financeiro']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // Anexos gerais (4.10) — leitura por todos autenticados, escrita por qualquer logado (validação de empresa fica no Firestore)
    match /pedidos/{pedidoId}/anexos/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
             'application/pdf|image/.*|application/vnd\\.openxmlformats.*|application/msword'
           );
      allow delete: if request.auth != null;
    }

  }
}
